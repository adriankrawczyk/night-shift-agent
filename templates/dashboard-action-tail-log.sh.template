#!/usr/bin/env bash
# Tail today's night agent log in Terminal.
# Invoked from the SwiftBar widget action.
#
# Generated by Night Shift Agent installer v{{ installer_version }} at {{ generated_at }}.

set -u
ROUTINE_DIR="{{ install_dir }}"
TODAY="$(date +%F)"
LOG="$ROUTINE_DIR/runs/$TODAY-local.log"

# Fall back to most recent log if today's not present yet
if [[ ! -f "$LOG" ]]; then
  LOG=$(ls -t "$ROUTINE_DIR"/runs/*.log 2>/dev/null | head -1)
fi

if [[ -z "$LOG" || ! -f "$LOG" ]]; then
  echo "No log found in $ROUTINE_DIR/runs/"
  sleep 5
  exit 1
fi

echo "→ Tailing $LOG (Ctrl+C to exit)"
echo ""
exec tail -f "$LOG"
