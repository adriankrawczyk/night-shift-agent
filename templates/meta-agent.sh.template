#!/usr/bin/env zsh
# meta-agent.sh — post-run self-improvement. Reads logs from the run that just
# finished, opens PRs against your night-shift-agent repo to improve setup.
#
# Generated by Night Shift Agent installer. Meta-agent mode: {{ meta_agent }}

set -uo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
export GIT_OPTIONAL_LOCKS=0

# Dependency check — meta-agent needs jq + gh + claude
for tool in jq gh claude; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "meta-agent: ERROR: '$tool' not in PATH — aborting (install with brew/curl)" >&2
    exit 1
  fi
done

ROUTINE_DIR="${NIGHT_SHIFT_DIR:-{{ install_dir }}}"
# shellcheck disable=SC2034  # RUNS_DIR used by meta-prompt.md via env
RUNS_DIR="$ROUTINE_DIR/runs"
META_LOG_DIR="$ROUTINE_DIR/runs"
TODAY_LOCAL=$(date +%Y-%m-%d)
META_LOG="$META_LOG_DIR/meta-${TODAY_LOCAL}.log"

# === Pattern P2: PATH already set above ===

# === Pattern P6: minimal logging ===
emit_log() { echo "$(date -u +%FT%TZ) [meta] $*" | tee -a "$META_LOG"; }

# === Pattern P1: meta-specific lock (with pid file for the suicide timer) ===
META_LOCK_DIR="$ROUTINE_DIR/.meta-lock"
META_LOCK_PID_FILE="$META_LOCK_DIR/pid"
GIT_MUTATE_OWNER_FILE="$ROUTINE_DIR/runs/.git-mutate.owner"
META_CAFFEINATE_PID=""
if ! mkdir "$META_LOCK_DIR" 2>/dev/null; then
  emit_log "FATAL: meta-lock held — exiting"
  exit 1
fi
echo $$ > "$META_LOCK_PID_FILE"

cleanup_meta() {
  # Release the shared git-mutate mutex if we own it (item: meta <-> daily race).
  if [[ -f "${GIT_MUTATE_OWNER_FILE:-}" ]]; then
    _gm_own=$(tr -dc '0-9' < "$GIT_MUTATE_OWNER_FILE" 2>/dev/null)
    [[ "$_gm_own" == "$$" ]] && rm -f "$GIT_MUTATE_OWNER_FILE"
  fi
  [[ -n "${META_CAFFEINATE_PID:-}" ]] && kill "$META_CAFFEINATE_PID" 2>/dev/null
  rm -rf "$META_LOCK_DIR"
}
trap 'cleanup_meta' EXIT

# Self-caffeinate — meta-agent runs detached post-night; hold our own sleep
# assertion so the Mac can't sleep mid-run and stall us. Killed in cleanup.
if command -v caffeinate >/dev/null 2>&1; then
  caffeinate -dis -t 2400 & META_CAFFEINATE_PID=$!
fi

# === Pattern P19: absolute wall-clock suicide timer (1h cap, far above the 1800s budget) ===
# Hard-bounds total wall time even if the per-attempt timeout fails. Poll loop so
# it ticks across macOS sleep; snapshot descendants before killing; self-abort if
# the lock is no longer ours. See BASH_PATTERNS.md P19.
META_ABS_MAX_S="${NIGHT_SHIFT_META_ABS_MAX_SEC:-3600}"
_meta_self=$$
(
  trap '' HUP INT TERM
  zmodload zsh/system 2>/dev/null
  _me="${sysparams[pid]:-0}"
  _dl=$(($(date +%s) + META_ABS_MAX_S))
  while (( $(date +%s) < _dl )); do sleep 60; done
  [[ -f "$META_LOCK_PID_FILE" && "$(cat "$META_LOCK_PID_FILE" 2>/dev/null)" == "$_meta_self" ]] || exit 0
  ps -p "$_meta_self" -o command= 2>/dev/null | grep -q 'meta-agent[.]sh' || exit 0
  typeset -a _vics
  # zsh-specific (script runs under zsh).
  # shellcheck disable=SC2296,SC2053,SC2179,SC2128,SC2034
  _collect() { local p=$1 c; for c in ${(f)"$(pgrep -P $p 2>/dev/null)"}; do [[ $c == $_me ]] && continue; _vics+=$c; _collect $c; done; }
  _collect "$_meta_self"
  kill -TERM "$_meta_self" 2>/dev/null; sleep 20
  # shellcheck disable=SC2128
  for c in $_vics; do kill -KILL "$c" 2>/dev/null; done
  kill -KILL "$_meta_self" 2>/dev/null
  [[ -f "$META_LOCK_PID_FILE" && "$(cat "$META_LOCK_PID_FILE" 2>/dev/null)" == "$_meta_self" ]] && rm -rf "$META_LOCK_DIR" 2>/dev/null
) &

emit_log "Meta-agent starting"

# === Check daily cap ===
GH_REPO="{{ gh_repo_full }}"
existing_today=$(gh pr list --repo "$GH_REPO" --state merged --search "[meta-agent] merged:>=$TODAY_LOCAL" --json number 2>/dev/null | jq length)
existing_open=$(gh pr list --repo "$GH_REPO" --state open --search "[meta-agent]" --json number 2>/dev/null | jq length)

if (( existing_today >= 1 )); then
  emit_log "Cap: meta-agent already shipped a PR today. Exiting."
  exit 0
fi

if (( existing_open >= 3 )); then
  emit_log "Cap: $existing_open meta-PRs already open. Exiting."
  exit 0
fi

# === Shared git-mutate mutex (meta-agent <-> daily-meta) ===
# Both agents checkout/reset the SAME install tree. Without a shared advisory
# mutex a concurrent checkout/reset race can destroy in-flight work. Non-blocking,
# self-healing (a dead owner is ignored); contended => defer cleanly. Acquire
# BEFORE the dirty-check; released in cleanup_meta.
mkdir -p "$ROUTINE_DIR/runs" 2>/dev/null
if [[ -f "$GIT_MUTATE_OWNER_FILE" ]]; then
  _gm_owner=$(tr -dc '0-9' < "$GIT_MUTATE_OWNER_FILE" 2>/dev/null)
  if [[ -n "$_gm_owner" ]] && [[ "$_gm_owner" != "$$" ]] && kill -0 "$_gm_owner" 2>/dev/null; then
    emit_log "DEFER: another git-mutating agent holds the shared mutex (PID $_gm_owner) — exiting"
    exit 0
  fi
fi
echo "$$" > "$GIT_MUTATE_OWNER_FILE"

# === Restore git working tree if dirty ===
if ! git -C "$ROUTINE_DIR" diff --quiet || ! git -C "$ROUTINE_DIR" diff --cached --quiet; then
  emit_log "Working tree dirty — stashing"
  git -C "$ROUTINE_DIR" stash push --include-untracked --quiet -m "meta-agent-pre-run" 2>>"$META_LOG"
fi

# Force checkout to main
git -C "$ROUTINE_DIR" checkout --quiet main 2>>"$META_LOG"
git -C "$ROUTINE_DIR" pull --quiet 2>>"$META_LOG" || emit_log "pull failed — using local main"

# === Create meta branch ===
META_BRANCH="meta/improvements-$(date -u +%FT%H%M)"
git -C "$ROUTINE_DIR" checkout -b "$META_BRANCH" 2>>"$META_LOG"

# === Run claude on the meta-prompt ===
META_PROMPT="$ROUTINE_DIR/meta-prompt.md"
META_TIMEOUT_SEC=1800

if command -v gtimeout >/dev/null 2>&1; then
  TIMEOUT_BIN=gtimeout
elif command -v timeout >/dev/null 2>&1; then
  TIMEOUT_BIN=timeout
else
  TIMEOUT_BIN=""
fi

emit_log "Invoking meta-claude (timeout $META_TIMEOUT_SEC s)"

if [[ -n "$TIMEOUT_BIN" ]]; then
  "$TIMEOUT_BIN" --kill-after=30 "$META_TIMEOUT_SEC" \
    "$HOME/.local/bin/claude" --print --permission-mode bypassPermissions \
    --add-dir "$ROUTINE_DIR" \
    < "$META_PROMPT" 2>&1 | tee -a "$META_LOG"
else
  "$HOME/.local/bin/claude" --print --permission-mode bypassPermissions \
    --add-dir "$ROUTINE_DIR" \
    < "$META_PROMPT" 2>&1 | tee -a "$META_LOG"
fi

META_EXIT="${pipestatus[1]:-0}"
emit_log "meta-claude exited with code $META_EXIT"

# === Read decision file ===
DECISION_FILE="/tmp/meta-agent-decision.json"
if [[ ! -f "$DECISION_FILE" ]]; then
  emit_log "No decision file from meta-claude — defaulting to no changes"
  git -C "$ROUTINE_DIR" checkout --quiet main 2>>"$META_LOG"
  git -C "$ROUTINE_DIR" branch -D "$META_BRANCH" 2>/dev/null
  exit 0
fi

DECISION_CLASS=$(jq -r '.class // "none"' "$DECISION_FILE")
AUTO_MERGE=$(jq -r 'if .auto_merge == true then 1 else 0 end' "$DECISION_FILE")
SUMMARY=$(jq -r '.summary // ""' "$DECISION_FILE")

emit_log "Decision: class=$DECISION_CLASS auto_merge=$AUTO_MERGE"

# === RUN-HEALTH gate (trust but verify) ===
# class=run-health means meta-claude applied a fix from RUN-HEALTH.md to restore a
# documented defense layer. We do NOT trust its self-reported validation: re-run
# verify-invariants.sh ourselves against the working tree carrying the fix.
# Auto-merge ONLY if every invariant passes; on FAIL the fix didn't take →
# abandon (status quo stays safe, no merge, no PR, no nag).
if [[ "$DECISION_CLASS" == "run-health" ]]; then
  if [[ -x "$ROUTINE_DIR/verify-invariants.sh" ]] && "$ROUTINE_DIR/verify-invariants.sh" >/dev/null 2>&1; then
    AUTO_MERGE=1
    emit_log "run-health: verify-invariants PASSED — auto-merge authorized (gated)"
  else
    emit_log "run-health: verify-invariants FAILED — abandoning self-change (status quo preserved)"
    git -C "$ROUTINE_DIR" checkout -- . 2>>"$META_LOG"
    git -C "$ROUTINE_DIR" checkout --quiet main 2>>"$META_LOG"
    git -C "$ROUTINE_DIR" branch -D "$META_BRANCH" 2>/dev/null
    exit 0
  fi
fi

if [[ "$DECISION_CLASS" == "none" ]]; then
  emit_log "No improvements proposed — cleaning up"
  git -C "$ROUTINE_DIR" checkout --quiet main 2>>"$META_LOG"
  git -C "$ROUTINE_DIR" branch -D "$META_BRANCH" 2>/dev/null
  exit 0
fi

# === RE-RUN HELPER (called below in two places: no-changes branch + end of script) ===
# Reads /tmp/meta-agent-decision.json for request_rerun + rerun_reason fields.
# If request_rerun=true AND criteria pass (≥4h until next deadline, no prior
# re-run today), overwrites coord status='failed' (so STEP 0.4 doesn't skip),
# creates anti-loop flag, then nohup-spawns run.sh again. This is how meta-agent
# recovers from a broken brief by triggering a fresh night-agent run.
RERUN_DECISION_FILE="/tmp/meta-agent-decision.json"
RERUN_DEADLINE_HOUR="${RERUN_DEADLINE_HOUR:-8}"   # 08:00 local — minimum buffer before the user wakes up

# Deterministic "did the latest night run crash?" — TRUE when the most recent run
# jsonl shows no delivered brief AND no legit agent-declared skip, but the run
# terminated (preflight_failed, or run_finished without delivery). This fires even
# if meta-claude itself hung and never wrote request_rerun — the bulletproof half
# of rerun-until-pass.
night_run_crashed() {
  local j
  j=$(ls -t "$ROUTINE_DIR"/runs/*/*.jsonl "$ROUTINE_DIR"/runs/[0-9]*.jsonl 2>/dev/null | head -1)
  [[ -z "$j" || ! -f "$j" ]] && return 1
  grep -q '"event":"delivery_complete"' "$j" 2>/dev/null && return 1
  grep -q '"event":"skip_declared"' "$j" 2>/dev/null && return 1
  grep -qE '"event":"(preflight_failed|run_finished)"' "$j" 2>/dev/null && return 0
  return 1
}

maybe_spawn_rerun() {
  command -v jq >/dev/null 2>&1 || return

  local request_rerun="false" rerun_reason="unspecified"
  if [[ -f "$RERUN_DECISION_FILE" ]] && jq empty "$RERUN_DECISION_FILE" 2>/dev/null; then
    request_rerun=$(jq -r '.request_rerun // false' "$RERUN_DECISION_FILE")
    rerun_reason=$(jq -r '.rerun_reason // "unspecified"' "$RERUN_DECISION_FILE")
  fi
  if night_run_crashed; then
    request_rerun="true"
    [[ "$rerun_reason" == "unspecified" ]] && rerun_reason="deterministic: latest night run crashed (no delivery, no legit skip)"
  fi
  [[ "$request_rerun" != "true" ]] && return

  # Per-night retry CAP (counter, not a one-shot flag): re-run "until it passes
  # OR the cap is hit". The run.sh -> meta-agent spawn is the outer loop.
  local rerun_cap="${NIGHT_SHIFT_RERUN_CAP:-4}"
  local rerun_count_file="$ROUTINE_DIR/runs/${TODAY_LOCAL}-rerun.count"
  local rerun_count=0
  [[ -f "$rerun_count_file" ]] && rerun_count=$(tr -dc '0-9' < "$rerun_count_file" 2>/dev/null)
  rerun_count=${rerun_count:-0}
  if (( rerun_count >= rerun_cap )); then
    emit_log "Re-run NEEDED but per-night cap reached ($rerun_count/$rerun_cap) — stopping"
    return
  fi
  # Don't spawn a duplicate while a run.sh already holds the lock.
  if [[ -f "$ROUTINE_DIR/.lock/pid" ]]; then
    local _lp; _lp=$(tr -dc '0-9' < "$ROUTINE_DIR/.lock/pid" 2>/dev/null)
    if [[ -n "$_lp" ]] && kill -0 "$_lp" 2>/dev/null; then
      emit_log "Re-run NEEDED but a run.sh already holds the lock (PID $_lp) — not spawning a duplicate"
      return
    fi
  fi

  # Time budget: need ≥4h until RERUN_DEADLINE_HOUR local. Computed via BSD date
  # so this stays macOS-only (consistent with the rest of the installer).
  local now_ts target_ts hours_until_deadline today_iso
  now_ts=$(date +%s)
  today_iso=$(date +%F)
  target_ts=$(date -j -f '%Y-%m-%d %H:%M' "$today_iso ${RERUN_DEADLINE_HOUR}:00" +%s 2>/dev/null || echo 0)
  if (( target_ts <= now_ts )); then
    target_ts=$(date -j -v+1d -f '%Y-%m-%d %H:%M' "$(date -v+1d +%F) ${RERUN_DEADLINE_HOUR}:00" +%s 2>/dev/null || echo 0)
  fi
  if (( target_ts == 0 )); then
    emit_log "Re-run check: could not compute target ${RERUN_DEADLINE_HOUR}:00 — skipping defensively"
    return
  fi
  hours_until_deadline=$(( (target_ts - now_ts) / 3600 ))
  if (( hours_until_deadline < 4 )); then
    emit_log "Re-run REQUESTED but only ${hours_until_deadline}h until ${RERUN_DEADLINE_HOUR}:00 — skipping (need ≥4h)"
    return
  fi

  emit_log "Re-run APPROVED (attempt $((rerun_count+1))/$rerun_cap): reason='$rerun_reason', ${hours_until_deadline}h until ${RERUN_DEADLINE_HOUR}:00"
  echo "$(( rerun_count + 1 ))" > "$rerun_count_file"

  {{#if multi_machine}}
  # Overwrite coord status='failed' so night-agent's STEP 0.4 doesn't skip
  local gist_id_file="$ROUTINE_DIR/runs/coord-gist-id.txt"
  if [[ -f "$gist_id_file" ]]; then
    local gist_id; gist_id="$(cat "$gist_id_file" 2>/dev/null | tr -d '[:space:]')"
    if [[ -n "$gist_id" ]] && command -v gh >/dev/null 2>&1; then
      local coord_tmp; coord_tmp=$(mktemp)
      if gh gist view "$gist_id" -f coord.json > "$coord_tmp" 2>/dev/null; then
        jq --arg note "meta-agent re-run requested: $rerun_reason" \
           '.by_mode.local.status = "failed"
            | .by_mode.local.completed_at = null
            | .by_mode.local.rerun_note = $note' "$coord_tmp" > "$coord_tmp.new" \
          && mv "$coord_tmp.new" "$coord_tmp"
        gh gist edit "$gist_id" -f coord.json "$coord_tmp" 2>&1 | tee -a "$META_LOG"
        emit_log "Coord gist overwritten: status='failed' with rerun_note"
      fi
      rm -f "$coord_tmp"
    fi
  fi
  {{/if}}

  # Spawn fresh run.sh detached
  nohup "$ROUTINE_DIR/run.sh" > /dev/null 2>&1 &
  disown 2>/dev/null || true
  emit_log "Spawned re-run of run.sh (detached PID $!)"
}

# === Check if anything changed ===
if git -C "$ROUTINE_DIR" diff --quiet main..HEAD; then
  emit_log "No actual diff vs main — meta-claude said it'd change things but didn't"
  git -C "$ROUTINE_DIR" checkout --quiet main
  git -C "$ROUTINE_DIR" branch -D "$META_BRANCH" 2>/dev/null
  maybe_spawn_rerun
  exit 0
fi

# === Commit + push + PR ===
git -C "$ROUTINE_DIR" add -A 2>>"$META_LOG"
git -C "$ROUTINE_DIR" commit -m "[meta-agent][$DECISION_CLASS] $SUMMARY" 2>>"$META_LOG"
git -C "$ROUTINE_DIR" push -u origin "$META_BRANCH" 2>>"$META_LOG"

PR_DRAFT_FLAG=""
if [[ "$DECISION_CLASS" != "tactical" && "$DECISION_CLASS" != "run-health" ]]; then
  PR_DRAFT_FLAG="--draft"
fi

PR_OUT=$(mktemp)
PR_ERR=$(mktemp)
trap 'rm -f "$PR_OUT" "$PR_ERR"' EXIT INT TERM
gh pr create --repo "$GH_REPO" \
  --title "[meta-agent][$DECISION_CLASS] $TODAY_LOCAL: $SUMMARY" \
  --body-file <(jq -r '.report // "Meta-agent run report"' "$DECISION_FILE") \
  --base main --head "$META_BRANCH" \
  $PR_DRAFT_FLAG \
  > "$PR_OUT" 2> "$PR_ERR"

PR_URL=$(grep -oE 'https://github\.com/[^/]+/[^/]+/pull/[0-9]+' "$PR_OUT" | head -1)
emit_log "PR created: $PR_URL"

# === Auto-merge if tactical AND user enabled ===
if [[ "$AUTO_MERGE" == "1" ]] && { [[ "$DECISION_CLASS" == "tactical" ]] || [[ "$DECISION_CLASS" == "run-health" ]]; }; then
  gh pr merge "$PR_URL" --merge --delete-branch 2>>"$META_LOG" && \
    emit_log "Auto-merged $DECISION_CLASS PR"
fi

# === Notify user about architectural PRs (need their review) ===
# Tactical PRs auto-merge silently. Architectural PRs are draft + need a human
# decision — surface them via terminal-notifier (silent fallback to osascript).
if [[ "$DECISION_CLASS" != "tactical" ]] && [[ "$DECISION_CLASS" != "run-health" ]] && [[ -n "$PR_URL" ]]; then
  PR_NUMBER=$(echo "$PR_URL" | grep -oE '[0-9]+$')
  NOTIFY_TITLE="Meta-agent: ${DECISION_CLASS} PR pending"
  NOTIFY_SUB="PR #${PR_NUMBER} — review when free"
  NOTIFY_MSG="${SUMMARY:0:120}"
  if command -v terminal-notifier >/dev/null 2>&1; then
    terminal-notifier -title "$NOTIFY_TITLE" -subtitle "$NOTIFY_SUB" -message "$NOTIFY_MSG" -open "$PR_URL" -sound Submarine 2>/dev/null || true
  else
    osascript -e "display notification \"$NOTIFY_MSG\" with title \"$NOTIFY_TITLE\" subtitle \"$NOTIFY_SUB\" sound name \"Submarine\"" 2>/dev/null || true
  fi
  # Sentinel for the next run — the prompt's STEP 0 can check this and avoid
  # proposing the same architectural change twice while it's still pending.
  SENTINEL_DIR="$ROUTINE_DIR/runs"
  mkdir -p "$SENTINEL_DIR"
  printf '{"pr":%s,"class":"%s","opened_at_utc":"%s","status":"pending_review"}\n' \
    "$PR_NUMBER" "$DECISION_CLASS" "$(date -u +%FT%TZ)" \
    > "$SENTINEL_DIR/architectural-pending-${TODAY_LOCAL}.json"
  emit_log "Architectural sentinel: $SENTINEL_DIR/architectural-pending-${TODAY_LOCAL}.json"
fi

# === Append to META-DECISIONS.md ledger (shared, append-only) ===
# Records every meta-agent PR + verdict. The prompt reads this on next run to
# avoid re-proposing reverted changes (do_not_touch field, manually settable).
META_DECISIONS_FILE="$ROUTINE_DIR/META-DECISIONS.md"
if [[ -f "$META_DECISIONS_FILE" ]] && [[ -n "$PR_URL" ]]; then
  PR_NUMBER=$(echo "$PR_URL" | grep -oE '[0-9]+$')
  {
    echo ""
    echo "- pr: $PR_NUMBER"
    echo "  date_local: $TODAY_LOCAL"
    echo "  class: $DECISION_CLASS"
    echo "  auto_merged: $([[ "$AUTO_MERGE" == "1" ]] && { [[ "$DECISION_CLASS" == "tactical" ]] || [[ "$DECISION_CLASS" == "run-health" ]]; } && echo true || echo false)"
    echo "  pr_url: $PR_URL"
    echo "  summary: |"
    echo "    ${SUMMARY:-(no summary)}"
    echo "  user_reverted: false"
    echo "  user_modified: false"
    echo "  do_not_touch: false"
  } >> "$META_DECISIONS_FILE"
  # Commit the ledger update straight to main (metadata-only, low-risk).
  if [[ -n "$(git -C "$ROUTINE_DIR" status --porcelain META-DECISIONS.md 2>/dev/null)" ]]; then
    git -C "$ROUTINE_DIR" add META-DECISIONS.md 2>>"$META_LOG"
    git -C "$ROUTINE_DIR" commit -m "meta-decisions: record PR #${PR_NUMBER}" --no-verify 2>>"$META_LOG" || true
    git -C "$ROUTINE_DIR" push --quiet 2>>"$META_LOG" || emit_log "WARN: META-DECISIONS push failed (non-fatal)"
  fi
fi

# === Restore stashed changes if any ===
if git -C "$ROUTINE_DIR" stash list | grep -q "meta-agent-pre-run"; then
  git -C "$ROUTINE_DIR" checkout --quiet main 2>>"$META_LOG"
  git -C "$ROUTINE_DIR" stash apply --quiet 2>>"$META_LOG" && \
    git -C "$ROUTINE_DIR" stash drop --quiet 2>>"$META_LOG"
fi

# Check whether the meta-claude flagged the night-run as broken and requested a re-run.
maybe_spawn_rerun

emit_log "Meta-agent done"
