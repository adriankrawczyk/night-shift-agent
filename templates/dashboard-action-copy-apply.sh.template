#!/usr/bin/env bash
# Copy "night-shift apply <id>" to clipboard + visual confirmation.
# Invoked from the SwiftBar widget when user clicks a patch entry.
#
# Generated by Night Shift Agent installer v{{ installer_version }} at {{ generated_at }}.

set -u
ID="${1:-}"
[[ -z "$ID" ]] && exit 1

CLI="{{ install_dir }}/cli/night-shift"

printf '%s apply %s' "$CLI" "$ID" | pbcopy

if command -v terminal-notifier >/dev/null 2>&1; then
  terminal-notifier \
    -title "Night Shift Agent" \
    -subtitle "Copied to clipboard" \
    -message "$CLI apply $ID" \
    -sound default 2>/dev/null || true
else
  osascript -e "display notification \"$CLI apply $ID\" with title \"Night Shift Agent\" subtitle \"Copied to clipboard\"" 2>/dev/null || true
fi
