# === MOBILE PREFLIGHT — boot iOS sim + start Metro for UI patches ===
# Without this, the agent burns budget per-patch on sim/Metro startup. We preempt
# both here so the agent inherits a working baseline. Failures non-fatal — agent
# decides whether to skip live-repro based on the JSONL events.
mobile_preflight() {
  # iOS sim — boot one if none running
  if ! command -v xcrun >/dev/null 2>&1; then
    emit_json warn mobile_preflight_no_xcrun
    return 0
  fi
  local booted
  booted="$(xcrun simctl list devices booted 2>/dev/null | grep -c 'iPhone' || true)"
  booted="${booted//[^0-9]/}"
  booted="${booted:-0}"
  if (( booted == 0 )); then
    local sim_id
    sim_id="$(xcrun simctl list devices available 2>/dev/null | grep -m1 'iPhone' | grep -oE '\([0-9A-F-]{36}\)' | tr -d '()')"
    if [[ -n "$sim_id" ]]; then
      log_both "Booting iOS simulator $sim_id"
      xcrun simctl boot "$sim_id" 2>>"$LOG" || true
      emit_json info mobile_preflight_sim_booted id="$sim_id"
    fi
  else
    emit_json info mobile_preflight_sim_already_booted count="$booted"
  fi

  # Metro — start if not already on 8081 (assumes default Metro port).
  # Detect project type → pick start command. Skip if no recognised mobile project.
  if ! lsof -i :8081 -sTCP:LISTEN >/dev/null 2>&1; then
    if ! command -v npx >/dev/null 2>&1; then
      emit_json warn mobile_preflight_no_npx
      return 0
    fi
    local start_cmd=""
    if [[ -f "$USER_REPO/app.json" ]] || [[ -f "$USER_REPO/app.config.js" ]] || [[ -f "$USER_REPO/app.config.ts" ]]; then
      start_cmd="npx expo start --no-dev --minify"
    elif [[ -f "$USER_REPO/metro.config.js" ]] || [[ -f "$USER_REPO/metro.config.ts" ]] || ([[ -f "$USER_REPO/package.json" ]] && grep -q '"react-native"' "$USER_REPO/package.json" 2>/dev/null); then
      start_cmd="npx react-native start"
    else
      emit_json info mobile_preflight_metro_skipped reason="no_expo_or_rn_detected"
      return 0
    fi
    log_both "Starting Metro bundler ($start_cmd, project: $USER_REPO)"
    # Spawn detached, log to its own file. Agent may stop/restart as needed.
    # shellcheck disable=SC2086
    (cd "$USER_REPO" && (eval "$start_cmd" >"$RUNTIME_DIR/metro.log" 2>&1 &) &)
    emit_json info mobile_preflight_metro_starting log="$RUNTIME_DIR/metro.log" cmd="$start_cmd"
  else
    emit_json info mobile_preflight_metro_already_up
  fi
}
mobile_preflight || true
{{/if}}

# === Set DRY_RUN env for agent ===
if [[ $DRY_RUN -eq 1 ]]; then
  export NIGHT_SHIFT_DRY_RUN=1
  log_both "DRY RUN mode"
else
  export NIGHT_SHIFT_DRY_RUN=0
fi

# === Pattern P13: auto-resume retry loop ===
MAX_CLAUDE_ATTEMPTS={{ max_resume_attempts }}
MAX_RATE_LIMIT_RETRIES=3
RATE_LIMIT_RETRIES=0
ATTEMPT=1

delivery_complete() {
  # brief.md is the canonical local copy — agent must write it regardless
  # of which downstream channels are configured. Other channels (email,
  # slack, drive) READ from this file to deliver. If it's missing, the
  # agent didn't finish — retry.
  [[ -f "$RUNTIME_DIR/brief.md" ]] || return 1
  return 0
}

while (( ATTEMPT <= MAX_CLAUDE_ATTEMPTS )); do
  if (( ATTEMPT > 1 )); then
    log_both "=== ATTEMPT $ATTEMPT of $MAX_CLAUDE_ATTEMPTS — RESUMING ==="
    [[ ! -f "$STALL_WATCHDOG_PID_FILE" ]] && start_stall_watchdog
    [[ ! -f "$HEARTBEAT_PID_FILE" ]] && start_heartbeat_writer
  fi

  log_both "Invoking claude (attempt $ATTEMPT)"
  emit_json info claude_attempt n="$ATTEMPT"

  # Run claude via timeout wrapper
  case "$TIMEOUT_BIN" in
    gtimeout|timeout)
      "$TIMEOUT_BIN" --kill-after=30 "$CLAUDE_HARD_TIMEOUT_SEC" \
        "$HOME/.local/bin/claude" \
          --print \
          --permission-mode bypassPermissions \
          --add-dir "$RUNTIME_DIR" \
          --add-dir "/tmp/night-shift-agent" \
          < "$PROMPT" 2>&1 | tee -a "$LOG"
      ;;
    perl-alarm)
      # NB: previous version did `alarm $t; exec @ARGV` which is BROKEN —
      # `exec` replaces the perl process with the child, so SIGALRM never
      # fires and the wall is effectively infinite. Fix: fork the child,
      # arm alarm in the parent, kill the child group on alarm.
      perl -e '
        my $timeout = shift;
        my $pid = fork;
        die "fork failed: $!" unless defined $pid;
        if ($pid == 0) {
          setpgrp(0, 0);  # new process group so we can kill children together
          exec @ARGV;
          die "exec failed: $!";
        }
        $SIG{ALRM} = sub {
          kill 15, -$pid; sleep 5; kill 9, -$pid;
          exit 124;
        };
        alarm $timeout;
        waitpid $pid, 0;
        alarm 0;
        my $rc = $? >> 8;
        my $sig = $? & 127;
        exit ($sig ? 128 + $sig : $rc);
      ' \
        "$CLAUDE_HARD_TIMEOUT_SEC" \
        "$HOME/.local/bin/claude" \
          --print \
          --permission-mode bypassPermissions \
          --add-dir "$RUNTIME_DIR" \
          --add-dir "/tmp/night-shift-agent" \
          < "$PROMPT" 2>&1 | tee -a "$LOG"
      ;;
    *)
      log_both "WARN: no timeout — running unwrapped"
      "$HOME/.local/bin/claude" \
        --print \
        --permission-mode bypassPermissions \
        --add-dir "$RUNTIME_DIR" \
        --add-dir "/tmp/night-shift-agent" \
        < "$PROMPT" 2>&1 | tee -a "$LOG"
      ;;
  esac
  # NB: ${pipestatus[1]} is zsh (lowercase, 1-indexed). bash uses ${PIPESTATUS[0]}.
  # Without this, you'd read tee's exit (always 0) instead of claude's.
  CLAUDE_EXIT="${pipestatus[1]:-0}"

  case "$CLAUDE_EXIT" in
    124) log_both "ERR: hard timeout" ;;
    137) log_both "ERR: required SIGKILL" ;;
    143)
      log_both "ERR: SIGTERM — possibly stall watchdog"
      # Pattern P16 forensic
      {{ pattern.P16 }}
      ;;
    0)   log_both "OK: claude exited cleanly" ;;
    *)   log_both "WARN: exit $CLAUDE_EXIT" ;;
  esac

  if delivery_complete; then
    log_both "Delivery complete — stopping retry loop"
    emit_json info delivery_complete
    {{#if ui_automation_enabled}}
    # UI-automation skip-fraud check — if wrapper confirmed the UI-automation
    # tool is available but the agent never logged the mandatory ground-truth
    # probe event ("ui_devices_listed_at_step3"), the agent likely rationalized
    # a skip with introspection-based excuses. Loud warning so morning triage
    # catches it; doesn't fail delivery (brief still ships).
    if [[ "${DRY_RUN:-0}" -eq 0 ]] && [[ "${NIGHT_SHIFT_UI_AUTOMATION_AVAILABLE:-0}" == "1" ]] && ! grep -q 'ui_devices_listed_at_step3' "$JSON_LOG" 2>/dev/null; then
      emit_json error ui_automation_probe_missing reason="agent never logged ui_devices_listed_at_step3 despite NIGHT_SHIFT_UI_AUTOMATION_AVAILABLE=1"
      log_both "WARNING: agent skipped mandatory UI-automation ground-truth probe — likely fraudulent skip in brief"
    fi
    {{/if}}
    {{#if uses_macos_notification}}
    # macOS banner — fires regardless of other channels; minimal-tier user's main UX touchpoint.
    # Subtitle pulls patch + review counts from the brief if present.
    if command -v osascript >/dev/null 2>&1; then
      brief_path="$RUNTIME_DIR/brief.md"
      patches_count=$(find "$RUNTIME_DIR" -maxdepth 1 -name '*.patch' 2>/dev/null | wc -l | tr -d ' ')
      subtitle="$patches_count patch(es) ready — run 'night-shift brief' to open"
      osascript -e "display notification \"$subtitle\" with title \"Night Shift Agent\" sound name \"Glass\"" 2>/dev/null || true
    fi
    {{/if}}
    break
  fi

  # Skip flag check
  if [[ -f "$LOG_DIR/${RUN_DATE_LOCAL}-skip.flag" ]]; then
    log_both "Skip declared by agent — done"
    emit_json info skip_declared
    break
  fi

  # Rate-limit AND server-overload detection (429 + 529).
  # claude --print can emit two distinct error families that should NOT count
  # toward MAX_CLAUDE_ATTEMPTS:
  #   - 429 / "usage limit reached" / "rate_limit_error" — real usage block;
  #     response often includes a reset ISO timestamp or "in 4h 12m" phrase
  #   - 529 / "Overloaded" / "overloaded_error" — transient Anthropic outage,
  #     no reset time; typically resolves within minutes
  # Both share MAX_RATE_LIMIT_RETRIES; without distinguishing them, a 15-min
  # Anthropic outage burns the entire 3-attempt budget on 30-second retries.
  RATE_LIMIT_HIT=0
  OVERLOAD_HIT=0
  RATE_LIMIT_RESET_EPOCH=0
  if [[ -f "$LOG" ]]; then
    # Detection + reset-time parsing live in log_has_rate_limit / log_has_overload
    # / compute_rate_limit_reset_epoch at the top of this file (single source of
    # truth) so validate.sh can behaviorally test them on synthetic logs. See the
    # note there on why presence-grepping the regex is not enough.
    if log_has_rate_limit "$LOG"; then
      RATE_LIMIT_HIT=1
      RATE_LIMIT_RESET_EPOCH=$(compute_rate_limit_reset_epoch "$LOG")
    elif log_has_overload "$LOG"; then
      OVERLOAD_HIT=1
      # Server-side overload — exponential backoff (120s, 240s, 360s) capped
      # by MAX_RATE_LIMIT_RETRIES so a sustained outage doesn't hang forever.
      RATE_LIMIT_RESET_EPOCH=$(( $(date -u +%s) + (RATE_LIMIT_RETRIES + 1) * 120 ))
    fi
  fi

  if (( RATE_LIMIT_HIT == 1 || OVERLOAD_HIT == 1 )) && (( RATE_LIMIT_RETRIES < MAX_RATE_LIMIT_RETRIES )); then
    NOW_EPOCH=$(date -u +%s)
    WAIT_FOR=$(( RATE_LIMIT_RESET_EPOCH - NOW_EPOCH ))
    (( WAIT_FOR < 30 )) && WAIT_FOR=30
    (( WAIT_FOR > 21600 )) && WAIT_FOR=21600   # 6h cap
    RATE_LIMIT_RETRIES=$((RATE_LIMIT_RETRIES+1))
    if (( OVERLOAD_HIT == 1 )); then
      log_both "API OVERLOAD (529) detected (retry $RATE_LIMIT_RETRIES/$MAX_RATE_LIMIT_RETRIES) — sleeping ${WAIT_FOR}s, then resuming SAME attempt #$ATTEMPT"
      emit_json warn api_overloaded_529 wait_s="$WAIT_FOR" attempt="$ATTEMPT" retry="$RATE_LIMIT_RETRIES"
    else
      log_both "RATE-LIMIT detected (retry $RATE_LIMIT_RETRIES/$MAX_RATE_LIMIT_RETRIES) — sleeping ${WAIT_FOR}s, then resuming SAME attempt #$ATTEMPT"
      emit_json warn rate_limit_sleep wait_s="$WAIT_FOR" attempt="$ATTEMPT" retry="$RATE_LIMIT_RETRIES"
    fi
    # Chunked sleep so SIGTERM (cleanup trap) can interrupt
    REMAINING="$WAIT_FOR"
    while (( REMAINING > 0 )); do
      CHUNK=60
      (( REMAINING < CHUNK )) && CHUNK="$REMAINING"
      sleep "$CHUNK"
      REMAINING=$(( REMAINING - CHUNK ))
    done
    # IMPORTANT: continue WITHOUT incrementing ATTEMPT — rate-limit retries
    # don't count toward MAX_CLAUDE_ATTEMPTS, only real failures do.
    continue
  fi

  if (( ATTEMPT < MAX_CLAUDE_ATTEMPTS )); then
    log_both "Delivery incomplete after attempt $ATTEMPT — sleeping 30s then retry"
    sleep 30
  else
    log_both "FAIL: delivery incomplete after $MAX_CLAUDE_ATTEMPTS attempts"
  fi
  ATTEMPT=$((ATTEMPT + 1))
done

# === Restore user repo state (all projects) ===
{{#if snapshot_user_repo}}
log_both "Restoring user repo state (all projects)"
{{#each projects}}
ub_restore_multi "{{ @index }}" "$USER_REPO_{{ @index }}"
{{/each}}
{{/if}}

# === Spawn meta-agent if enabled (detached, so cleanup trap doesn't wait) ===
{{#if meta_agent_enabled}}
if [[ -x "$ROUTINE_DIR/meta-agent.sh" ]] && [[ $DRY_RUN -eq 0 ]]; then
  log_both "Spawning meta-agent in background (post-run self-improvement)"
  emit_json info meta_agent_spawning
  nohup "$ROUTINE_DIR/meta-agent.sh" \
    > "$LOG_DIR/meta-spawn-$(date -u +%FT%H%M).log" 2>&1 < /dev/null &
  disown 2>/dev/null || true
fi
{{/if}}

# === Cleanup runs via trap EXIT ===
log_both "Run finished at $(date -u +%FT%TZ)"
emit_json info run_finished claude_exit="$CLAUDE_EXIT"
exit 0
