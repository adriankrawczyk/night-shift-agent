#!/usr/bin/env zsh
set -uo pipefail

# Night Shift Agent — runner script
# Generated by the wizard on {{ generated_at }}
# Installer: v{{ installer_version }} ({{ installer_commit }})
# Tier: {{ tier }}  Recipes: {{ recipes }}
#
# Usage:
#   ./run.sh                  # production run
#   ./run.sh --dry-run        # invoke agent with NIGHT_SHIFT_DRY_RUN=1 (no artifacts)
#   ./run.sh --preflight      # validate environment, no agent invocation
#   ./run.sh --help

# === ARG PARSING ===
DRY_RUN=0
PREFLIGHT_ONLY=0
for arg in "$@"; do
  case "$arg" in
    --dry-run)   DRY_RUN=1 ;;
    --preflight) PREFLIGHT_ONLY=1 ;;
    --help|-h)
      sed -n '4,11p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *)
      echo "Unknown flag: $arg (use --help)" >&2
      exit 2 ;;
  esac
done

# === CONFIG ===
ROUTINE_DIR="${NIGHT_SHIFT_DIR:-{{ install_dir }}}"
{{#each projects}}
USER_REPO_{{ @index }}="${NIGHT_SHIFT_PROJECT_{{ @index }}:-{{ this.path }}}"
{{/each}}
# Primary project (most operations use this; multi-project recipes iterate)
USER_REPO="${USER_REPO_0}"

PROMPT="$ROUTINE_DIR/prompt.md"
SETTINGS="$ROUTINE_DIR/settings.json"
# NB: LOCK_DIR + LOCK_PID_FILE are defined inside pattern.P1 below — don't
# duplicate the assignment here (the awk extractor pulls P1's full body).

# === Pattern P2: PATH setup BEFORE any tool lookup ===
{{ pattern.P2 }}

# === Timeout constants ===
CLAUDE_HARD_TIMEOUT_SEC={{ hard_wall_seconds }}

# === Pattern P7: timeout binary resolution ===
{{ pattern.P7 }}

# === Pattern P6: structured logging ===
{{ pattern.P6 }}

# === Pattern P1: atomic lock ===
{{ pattern.P1 }}

# === Pattern P3: heartbeat writer ===
{{ pattern.P3 }}

# === Pattern P4: stall watchdog ===
STALL_THRESHOLD={{ stall_threshold_seconds }}
{{ pattern.P4 }}

# === Pattern P5: idempotent cleanup trap ===
{{ pattern.P5 }}

# === Pattern P12: preflight ===
{{ pattern.P12 }}

# === Preflight-only mode exits early ===
if [[ $PREFLIGHT_ONLY -eq 1 ]]; then
  preflight
  PF_RC=$?
  exit $PF_RC
fi

# === Pattern P11: anti-jitter ===
{{ pattern.P11 }}

# === Acquire lock before any state mutation ===
if ! acquire_lock; then
  log_both "Lock acquire failed — exiting"
  exit 1
fi

# === Pattern P15: write wrapper.pid for dashboards ===
{{ pattern.P15 }}

# === Pattern P9: caffeinate (keep Mac awake) ===
{{#if resilience_caffeinate}}
{{ pattern.P9 }}
{{/if}}

# === Run preflight ===
preflight
PF_RC=$?
if [[ $PF_RC -eq 1 ]]; then
  log_both "FATAL: preflight failed (rc=1, hard errors) — aborting"
  emit_json error preflight_failed rc="$PF_RC"
  exit 1
elif [[ $PF_RC -eq 2 ]]; then
  log_both "Preflight passed with warnings"
fi

# === Pattern P8: network recovery ===
{{#if resilience_network_recovery}}
{{ pattern.P8 }}
{{/if}}

# === Skip policy check ===
{{ pattern.P14 }}

# === Setup runtime dirs ===
RUNTIME_DIR="$ROUTINE_DIR/runs/${RUN_DATE_LOCAL}"
mkdir -p "$RUNTIME_DIR"
export NIGHT_SHIFT_RUNTIME_DIR="$RUNTIME_DIR"

# === Load secrets if any ===
SECRETS_FILE="$HOME/.config/night-shift-agent/secrets.json"
if [[ -f "$SECRETS_FILE" ]]; then
  log_both "Loading secrets from $SECRETS_FILE"
  emit_json info secrets_loaded
  # Each secret becomes an env var. Use jq to extract.
  while IFS='=' read -r k v; do
    [[ -n "$k" ]] && export "$k=$v"
  done < <(jq -r 'to_entries[] | "\(.key)=\(.value)"' "$SECRETS_FILE")
fi

# === Start background writers ===
start_heartbeat_writer
{{#if resilience_stall_watchdog}}
start_stall_watchdog
{{/if}}

# === Start heartbeat ticker ===
date -u +%FT%TZ > "$RUNTIME_DIR/started.txt"

# === Begin pre-run snapshot (per Pattern P10) ===
{{#if snapshot_user_repo}}
log_both "Snapshotting user repo state"
{{ pattern.P10 }}
ub_snapshot "pre-run-${RUN_TS}"

# === WORKTREE SETUP — isolated checkout so agent never touches USER_REPO ===
# Snapshot above is the rollback safety net; this is the prevention. Agent operates
# in a detached worktree at $WORKTREE; USER_REPO stays untouched (and matches the
# baseline snapshot above) except for the protect-user-state.sh apply/restore window.
WORKTREE_PARENT="$ROUTINE_DIR/worktree"
WORKTREE="$WORKTREE_PARENT/$(basename "$USER_REPO")"
export NIGHT_SHIFT_AGENT_WORKTREE="$WORKTREE"

# Prune BEFORE creating to clear half-removed prior worktrees that would block naming.
git -C "$USER_REPO" worktree prune 2>>"$LOG" || true
mkdir -p "$WORKTREE_PARENT"

if [[ ! -e "$WORKTREE/.git" ]]; then
  # If the directory exists as a non-worktree husk (rm .git happened), wipe it
  # first — `git worktree add` aborts on "<path> already exists" otherwise.
  if [[ -d "$WORKTREE" ]]; then
    log_both "Removing stale non-git worktree husk at $WORKTREE"
    emit_json warn worktree_husk_removed path="$WORKTREE"
    rm -rf "$WORKTREE"
  fi
  log_both "Creating fresh worktree at $WORKTREE"
  emit_json info worktree_create path="$WORKTREE"
  git -C "$USER_REPO" fetch origin --quiet 2>>"$LOG" || true
  DEFAULT_BRANCH="$(git -C "$USER_REPO" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || echo main)"
  if ! git -C "$USER_REPO" worktree add --detach "$WORKTREE" "origin/$DEFAULT_BRANCH" 2>>"$LOG"; then
    log_both "ERROR: worktree add failed"
    emit_json error worktree_add_failed
    exit 1
  fi
else
  # Reset worktree to clean state so prior crashed-run state doesn't leak forward.
  git -C "$WORKTREE" reset --hard --quiet 2>>"$LOG" || true
  git -C "$WORKTREE" clean -fdx --quiet 2>>"$LOG" || true
fi
{{/if}}

{{#if (eq ui_automation_tool "argent")}}
# === ARGENT PROBE — side-channel ground truth ===
# Past incident: agent rationalized argent-skip with "MCP tools didn't load this
# session" while a same-flags claude --print repro proved all argent tools were
# present. Introspection lies. Probe the CLI ourselves and pass a deterministic
# flag the agent must respect. Post-run, grep JSONL for the resulting probe event
# to detect false-skip drift.
if argent --version >/dev/null 2>&1; then
  export NIGHT_SHIFT_ARGENT_AVAILABLE=1
  emit_json info argent_probe ok=true version="$(argent --version 2>/dev/null | head -1)"
else
  export NIGHT_SHIFT_ARGENT_AVAILABLE=0
  emit_json warn argent_probe ok=false reason="argent --version failed or CLI not on PATH"
fi

# === MOBILE PREFLIGHT — boot iOS sim + start Metro for UI patches ===
# Without this, the agent burns budget per-patch on sim/Metro startup. We preempt
# both here so the agent inherits a working baseline. Failures non-fatal — agent
# decides whether to skip live-repro based on the JSONL events.
mobile_preflight() {
  # iOS sim — boot one if none running
  if ! command -v xcrun >/dev/null 2>&1; then
    emit_json warn mobile_preflight_no_xcrun
    return 0
  fi
  local booted
  booted="$(xcrun simctl list devices booted 2>/dev/null | grep -c 'iPhone' || true)"
  booted="${booted//[^0-9]/}"
  booted="${booted:-0}"
  if (( booted == 0 )); then
    local sim_id
    sim_id="$(xcrun simctl list devices available 2>/dev/null | grep -m1 'iPhone' | grep -oE '\([0-9A-F-]{36}\)' | tr -d '()')"
    if [[ -n "$sim_id" ]]; then
      log_both "Booting iOS simulator $sim_id"
      xcrun simctl boot "$sim_id" 2>>"$LOG" || true
      emit_json info mobile_preflight_sim_booted id="$sim_id"
    fi
  else
    emit_json info mobile_preflight_sim_already_booted count="$booted"
  fi

  # Metro — start if not already on 8081 (assumes default Metro port).
  # Detect project type → pick start command. Skip if no recognised mobile project.
  if ! lsof -i :8081 -sTCP:LISTEN >/dev/null 2>&1; then
    if ! command -v npx >/dev/null 2>&1; then
      emit_json warn mobile_preflight_no_npx
      return 0
    fi
    local start_cmd=""
    if [[ -f "$USER_REPO/app.json" ]] || [[ -f "$USER_REPO/app.config.js" ]] || [[ -f "$USER_REPO/app.config.ts" ]]; then
      start_cmd="npx expo start --no-dev --minify"
    elif [[ -f "$USER_REPO/metro.config.js" ]] || [[ -f "$USER_REPO/metro.config.ts" ]] || ([[ -f "$USER_REPO/package.json" ]] && grep -q '"react-native"' "$USER_REPO/package.json" 2>/dev/null); then
      start_cmd="npx react-native start"
    else
      emit_json info mobile_preflight_metro_skipped reason="no_expo_or_rn_detected"
      return 0
    fi
    log_both "Starting Metro bundler ($start_cmd, project: $USER_REPO)"
    # Spawn detached, log to its own file. Agent may stop/restart as needed.
    # shellcheck disable=SC2086
    (cd "$USER_REPO" && (eval "$start_cmd" >"$RUNTIME_DIR/metro.log" 2>&1 &) &)
    emit_json info mobile_preflight_metro_starting log="$RUNTIME_DIR/metro.log" cmd="$start_cmd"
  else
    emit_json info mobile_preflight_metro_already_up
  fi
}
mobile_preflight || true
{{/if}}

# === Set DRY_RUN env for agent ===
if [[ $DRY_RUN -eq 1 ]]; then
  export NIGHT_SHIFT_DRY_RUN=1
  log_both "DRY RUN mode"
else
  export NIGHT_SHIFT_DRY_RUN=0
fi

# === Pattern P13: auto-resume retry loop ===
MAX_CLAUDE_ATTEMPTS={{ max_resume_attempts }}
MAX_RATE_LIMIT_RETRIES=3
RATE_LIMIT_RETRIES=0
ATTEMPT=1

delivery_complete() {
  # Recipe-defined success criterion. Check if expected outputs exist.
  {{#each output_channels}}
  {{#if (eq this "markdown")}}
  [[ -f "$RUNTIME_DIR/brief.md" ]] || return 1
  {{/if}}
  {{/each}}
  return 0
}

while (( ATTEMPT <= MAX_CLAUDE_ATTEMPTS )); do
  if (( ATTEMPT > 1 )); then
    log_both "=== ATTEMPT $ATTEMPT of $MAX_CLAUDE_ATTEMPTS — RESUMING ==="
    [[ ! -f "$STALL_WATCHDOG_PID_FILE" ]] && start_stall_watchdog
    [[ ! -f "$HEARTBEAT_PID_FILE" ]] && start_heartbeat_writer
  fi

  log_both "Invoking claude (attempt $ATTEMPT)"
  emit_json info claude_attempt n="$ATTEMPT"

  # Run claude via timeout wrapper
  case "$TIMEOUT_BIN" in
    gtimeout|timeout)
      "$TIMEOUT_BIN" --kill-after=30 "$CLAUDE_HARD_TIMEOUT_SEC" \
        "$HOME/.local/bin/claude" \
          --print \
          --permission-mode bypassPermissions \
          --add-dir "$RUNTIME_DIR" \
          --add-dir "/tmp/night-shift-agent" \
          < "$PROMPT" 2>&1 | tee -a "$LOG"
      ;;
    perl-alarm)
      perl -e '$t=shift; alarm $t; exec @ARGV; die "exec failed"' \
        "$CLAUDE_HARD_TIMEOUT_SEC" \
        "$HOME/.local/bin/claude" \
          --print \
          --permission-mode bypassPermissions \
          --add-dir "$RUNTIME_DIR" \
          --add-dir "/tmp/night-shift-agent" \
          < "$PROMPT" 2>&1 | tee -a "$LOG"
      ;;
    *)
      log_both "WARN: no timeout — running unwrapped"
      "$HOME/.local/bin/claude" \
        --print \
        --permission-mode bypassPermissions \
        --add-dir "$RUNTIME_DIR" \
        --add-dir "/tmp/night-shift-agent" \
        < "$PROMPT" 2>&1 | tee -a "$LOG"
      ;;
  esac
  # NB: ${pipestatus[1]} is zsh (lowercase, 1-indexed). bash uses ${PIPESTATUS[0]}.
  # Without this, you'd read tee's exit (always 0) instead of claude's.
  CLAUDE_EXIT="${pipestatus[1]:-0}"

  case "$CLAUDE_EXIT" in
    124) log_both "ERR: hard timeout" ;;
    137) log_both "ERR: required SIGKILL" ;;
    143)
      log_both "ERR: SIGTERM — possibly stall watchdog"
      # Pattern P16 forensic
      {{ pattern.P16 }}
      ;;
    0)   log_both "OK: claude exited cleanly" ;;
    *)   log_both "WARN: exit $CLAUDE_EXIT" ;;
  esac

  if delivery_complete; then
    log_both "Delivery complete — stopping retry loop"
    emit_json info delivery_complete
    {{#if uses_macos_notification}}
    # macOS banner — fires regardless of other channels; minimal-tier user's main UX touchpoint.
    # Subtitle pulls patch + review counts from the brief if present.
    if command -v osascript >/dev/null 2>&1; then
      brief_path="$RUNTIME_DIR/brief.md"
      patches_count=$(find "$RUNTIME_DIR" -maxdepth 1 -name '*.patch' 2>/dev/null | wc -l | tr -d ' ')
      subtitle="$patches_count patch(es) ready — run 'night-shift brief' to open"
      osascript -e "display notification \"$subtitle\" with title \"Night Shift Agent\" sound name \"Glass\"" 2>/dev/null || true
    fi
    {{/if}}
    break
  fi

  # Skip flag check
  if [[ -f "$LOG_DIR/${RUN_DATE_LOCAL}-skip.flag" ]]; then
    log_both "Skip declared by agent — done"
    emit_json info skip_declared
    break
  fi

  # Rate limit detection
  if grep -qiE 'usage limit (reached|exceeded)|rate.?limit_error|429 Too Many Requests' "$LOG" 2>/dev/null; then
    if (( RATE_LIMIT_RETRIES < MAX_RATE_LIMIT_RETRIES )); then
      log_both "Rate limited — waiting and retrying (without counting attempt)"
      RATE_LIMIT_RETRIES=$((RATE_LIMIT_RETRIES + 1))
      sleep $(( RATE_LIMIT_RETRIES * 600 ))
      continue
    fi
  fi

  if (( ATTEMPT < MAX_CLAUDE_ATTEMPTS )); then
    log_both "Delivery incomplete after attempt $ATTEMPT — sleeping 30s then retry"
    sleep 30
  else
    log_both "FAIL: delivery incomplete after $MAX_CLAUDE_ATTEMPTS attempts"
  fi
  ATTEMPT=$((ATTEMPT + 1))
done

# === Restore user repo if snapshotted ===
{{#if snapshot_user_repo}}
log_both "Restoring user repo state"
ub_restore
{{/if}}

# === Spawn meta-agent if enabled (detached, so cleanup trap doesn't wait) ===
{{#if meta_agent_enabled}}
if [[ -x "$ROUTINE_DIR/meta-agent.sh" ]] && [[ $DRY_RUN -eq 0 ]]; then
  log_both "Spawning meta-agent in background (post-run self-improvement)"
  emit_json info meta_agent_spawning
  nohup "$ROUTINE_DIR/meta-agent.sh" \
    > "$LOG_DIR/meta-spawn-$(date -u +%FT%H%M).log" 2>&1 < /dev/null &
  disown 2>/dev/null || true
fi
{{/if}}

# === Cleanup runs via trap EXIT ===
log_both "Run finished at $(date -u +%FT%TZ)"
emit_json info run_finished claude_exit="$CLAUDE_EXIT"
exit 0
