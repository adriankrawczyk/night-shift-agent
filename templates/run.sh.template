# === WORKTREE SETUP — isolated checkout per project so agent never touches USER_REPO ===
# Snapshot above is the rollback safety net; this is the prevention. Agent operates
# in detached worktrees at $WORKTREE_<N>; each USER_REPO_<N> stays untouched
# (matches its baseline snapshot) except for the protect-user-state.sh apply/restore window.
WORKTREE_PARENT="$ROUTINE_DIR/worktree"
mkdir -p "$WORKTREE_PARENT"

setup_worktree() {
  local idx="$1" user_repo="$2"
  local wt
  wt="$WORKTREE_PARENT/$(basename "$user_repo")"
  # Export per-project worktree path so the agent can target any project.
  export "NIGHT_SHIFT_AGENT_WORKTREE_${idx}=$wt"
  # First-project alias for backward compat with single-project guidance.
  if [[ "$idx" == "0" ]]; then
    export NIGHT_SHIFT_AGENT_WORKTREE="$wt"
  fi

  # Skip if user_repo isn't a git repo (e.g. ad-hoc folder) — no worktree possible.
  if ! git -C "$user_repo" rev-parse --git-dir >/dev/null 2>&1; then
    log_both "Skipping worktree for $user_repo (not a git repo)"
    emit_json warn worktree_skip_nongit path="$user_repo" idx="$idx"
    eval "WORKTREE_${idx}=\"$user_repo\""  # fall back to direct path; agent will know
    return 0
  fi

  # Prune BEFORE creating to clear half-removed prior worktrees that would block naming.
  git -C "$user_repo" worktree prune 2>>"$LOG" || true

  if [[ ! -e "$wt/.git" ]]; then
    if [[ -d "$wt" ]]; then
      log_both "Removing stale non-git worktree husk at $wt"
      emit_json warn worktree_husk_removed path="$wt" idx="$idx"
      rm -rf "$wt"
    fi
    log_both "Creating fresh worktree[$idx] at $wt"
    emit_json info worktree_create path="$wt" idx="$idx"
    git -C "$user_repo" fetch origin --quiet 2>>"$LOG" || true
    local default_branch
    default_branch="$(git -C "$user_repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || echo main)"
    if ! git -C "$user_repo" worktree add --detach "$wt" "origin/$default_branch" 2>>"$LOG"; then
      log_both "ERROR: worktree[$idx] add failed for $user_repo"
      emit_json error worktree_add_failed idx="$idx"
      # Primary failure aborts the run; secondary failures degrade to read-only.
      [[ "$idx" == "0" ]] && exit 1
      return 0
    fi
    eval "DEFAULT_BRANCH_${idx}=\"$default_branch\""
    if [[ "$idx" == "0" ]]; then
      # shellcheck disable=SC2034  # exported via prompt/recipe-level scripts
      DEFAULT_BRANCH="$default_branch"
    fi
  else
    git -C "$wt" reset --hard --quiet 2>>"$LOG" || true
    git -C "$wt" clean -fdx --quiet 2>>"$LOG" || true

    local default_branch post_reset_dirty post_reset_head_sha origin_main_sha
    default_branch="$(git -C "$user_repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || echo main)"
    post_reset_dirty="$(git -C "$wt" status --porcelain 2>/dev/null | head -5 | tr '\n' ';')"
    post_reset_head_sha="$(git -C "$wt" rev-parse HEAD 2>/dev/null || echo none)"
    origin_main_sha="$(git -C "$wt" rev-parse "origin/$default_branch" 2>/dev/null || echo none)"
    if [[ -n "$post_reset_dirty" || "$post_reset_head_sha" != "$origin_main_sha" ]]; then
      log_both "WARNING: worktree[$idx] still dirty/wrong-HEAD (dirty=$post_reset_dirty head=${post_reset_head_sha:0:7} expected=${origin_main_sha:0:7}) — escalating to full recreate"
      emit_json warn worktree_reset_failed idx="$idx" dirty="$post_reset_dirty" head="${post_reset_head_sha:0:7}" expected="${origin_main_sha:0:7}"
      {
        git -C "$user_repo" worktree remove --force "$wt" 2>&1 || true
        rm -rf "$wt" 2>&1 || true
        git -C "$user_repo" worktree prune 2>&1 || true
        git -C "$user_repo" worktree add --detach "$wt" "origin/$default_branch" 2>&1
      } 2>&1 | head -30 >>"$LOG"
      local post_recreate_dirty
      post_recreate_dirty="$(git -C "$wt" status --porcelain 2>/dev/null | head -5 | tr '\n' ';')"
      if [[ -n "$post_recreate_dirty" ]]; then
        log_both "ERROR: worktree[$idx] force-recreate also failed (dirty=$post_recreate_dirty)"
        emit_json error worktree_recreate_failed idx="$idx" dirty="$post_recreate_dirty"
        [[ "$idx" == "0" ]] && exit 1
        return 0
      fi
      log_both "Worktree[$idx] recreate OK (deps cache lost — preflight will rebuild)"
      emit_json info worktree_recreate_ok idx="$idx"
    fi
    eval "DEFAULT_BRANCH_${idx}=\"$default_branch\""
    if [[ "$idx" == "0" ]]; then
      # shellcheck disable=SC2034  # exported via prompt/recipe-level scripts
      DEFAULT_BRANCH="$default_branch"
    fi
  fi

  eval "WORKTREE_${idx}=\"$wt\""
}

{{#each projects}}
setup_worktree "{{ @index }}" "$USER_REPO_{{ @index }}"
{{/each}}
# Primary-project alias (used by single-project guidance in prompt.md)
