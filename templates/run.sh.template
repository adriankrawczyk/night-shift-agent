# === RATE-LIMIT / OVERLOAD DETECTION + RESET-TIME PARSER (pure; testable) ===
# Detection and reset-time parsing are extracted into pure functions plus hidden
# --selftest entrypoints so the test harness (validate.sh) can BEHAVIORALLY
# exercise them on synthetic logs, instead of only grepping for the regex's
# presence. Presence-only checks give false confidence: a matcher or parser can
# go dead (shadowed match, mis-anchored grep) while the grep that "proves" it
# stays green — and you only find out at the live reset hour. The retry loop far
# below calls these same functions, so they are the single source of truth.

# Reset-time parser: echo the UTC epoch at which the usage block resets (0 = no
# parseable signal). Handles three response shapes, in priority order:
#   1. ISO  "...will reset at 2026-05-29T02:05:00Z"  — constrained to lines
#      mentioning "reset" so the wrapper's own log-line timestamp prefixes can't
#      hijack the match and pin the epoch to ~now.
#   2. wall-clock  "resets 4am (America/New_York)"  — next occurrence of that
#      hour in the named TZ (falls back to the machine's local TZ if none given).
#   3. relative  "in 4h 12m"  — else a conservative 5h05m usage-block default.
compute_rate_limit_reset_epoch() {
  local LOG="$1"
  local RATE_LIMIT_RESET_EPOCH=0
  local RESET_ISO="" RESET_CLOCK="" RL_TZ="" RH="" RAP="" RL_TODAY="" TARGET=0
  local WAIT_HOURS="" WAIT_MINS="" WAIT_SEC=0
  [[ -f "$LOG" ]] || { echo 0; return; }
  # (1) ISO reset time — constrain to reset-lines so decoy ISO prefixes ignored.
  RESET_ISO=$(grep -iE 'reset' "$LOG" 2>/dev/null | grep -oE '20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z' | tail -1)
  if [[ -n "$RESET_ISO" ]]; then
    RATE_LIMIT_RESET_EPOCH=$(date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$RESET_ISO" +%s 2>/dev/null || echo 0)
  fi
  # (2) wall-clock "resets 4am (TZ)" — compute next occurrence of that hour.
  if (( RATE_LIMIT_RESET_EPOCH == 0 )); then
    RESET_CLOCK=$(grep -oiE 'reset[s]? [0-9]{1,2} ?(am|pm)' "$LOG" 2>/dev/null | tail -1)
    if [[ -n "$RESET_CLOCK" ]]; then
      RL_TZ=$(grep -oE '\(([A-Za-z]+/[A-Za-z_]+)\)' "$LOG" 2>/dev/null | tail -1 | tr -d '()')
      RH=$(echo "$RESET_CLOCK" | grep -oE '[0-9]{1,2}' | head -1)
      RAP=$(echo "$RESET_CLOCK" | grep -oiE '(am|pm)' | head -1 | tr 'A-Z' 'a-z')
      (( RH == 12 )) && RH=0
      [[ "$RAP" == "pm" ]] && RH=$(( RH + 12 ))
      # Use the message's TZ if present, otherwise the machine's local TZ. (TZ=""
      # would force UTC, so the empty case must NOT set TZ at all.)
      if [[ -n "$RL_TZ" ]]; then
        RL_TODAY=$(TZ="$RL_TZ" date +%F)
        TARGET=$(TZ="$RL_TZ" date -j -f "%Y-%m-%d %H:%M:%S" "$RL_TODAY $(printf '%02d' "$RH"):05:00" +%s 2>/dev/null || echo 0)
      else
        RL_TODAY=$(date +%F)
        TARGET=$(date -j -f "%Y-%m-%d %H:%M:%S" "$RL_TODAY $(printf '%02d' "$RH"):05:00" +%s 2>/dev/null || echo 0)
      fi
      # If that wall-clock instant already passed today, it means tomorrow.
      if (( TARGET > 0 && TARGET <= $(date -u +%s) )); then
        TARGET=$(( TARGET + 86400 ))
      fi
      (( TARGET > 0 )) && RATE_LIMIT_RESET_EPOCH="$TARGET"
    fi
  fi
  # (3) relative "in 4h 12m" — else conservative 5h05m default.
  if (( RATE_LIMIT_RESET_EPOCH == 0 )); then
    WAIT_HOURS=$(grep -oE 'in [0-9]+ ?h' "$LOG" 2>/dev/null | head -1 | grep -oE '[0-9]+' | head -1)
    WAIT_MINS=$(grep -oE 'in [0-9]+ ?(min|m)' "$LOG" 2>/dev/null | head -1 | grep -oE '[0-9]+' | head -1)
    WAIT_SEC=$(( ${WAIT_HOURS:-0} * 3600 + ${WAIT_MINS:-0} * 60 ))
    (( WAIT_SEC == 0 )) && WAIT_SEC=18300
    RATE_LIMIT_RESET_EPOCH=$(( $(date -u +%s) + WAIT_SEC ))
  fi
  echo "$RATE_LIMIT_RESET_EPOCH"
}

# Detection regexes — SINGLE SOURCE OF TRUTH (the retry loop matches via these).
# "hit your limit" + "limit (will )?reset" cover the Max-plan interactive message
# ("You've hit your limit · resets 4am"), which a bare "usage limit reached"
# regex misses — so the night would hard-fail instead of deferring to the reset.
RATE_LIMIT_DETECT_RE='usage limit (reached|exceeded)|usage_limit_reached|rate.?limit_error|429 Too Many Requests|hit your limit|limit (will )?reset'
OVERLOAD_DETECT_RE='API Error: 529|529 Overloaded|overloaded_error'

log_has_rate_limit() {  # $1=log path; exit 0 iff a usage/rate-limit signal present
  [[ -f "$1" ]] || return 1
  grep -qiE "$RATE_LIMIT_DETECT_RE" "$1" 2>/dev/null
}
log_has_overload() {    # $1=log path; exit 0 iff a transient 529 overload present
  [[ -f "$1" ]] || return 1
  grep -qiE "$OVERLOAD_DETECT_RE" "$1" 2>/dev/null
}

# Hidden test entrypoints — classify/parse a log and exit BEFORE any lock / PATH
# / launchd setup. Used by validate.sh's behavioral checks; never reached on a
# production run (no production caller passes these flags).
if [[ "${1:-}" == "--selftest-reset-epoch" ]]; then
  compute_rate_limit_reset_epoch "${2:-}"
  exit 0
fi
if [[ "${1:-}" == "--selftest-detect" ]]; then
  # Mirror the retry loop's precedence: rate-limit is checked before overload.
  if log_has_rate_limit "${2:-}"; then echo "ratelimit"
  elif log_has_overload "${2:-}"; then echo "overload"
  else echo "none"; fi
  exit 0
fi

