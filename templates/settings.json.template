{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Agent",
      "TodoWrite",
      "WebFetch",
      "WebSearch"{{#each existing_mcps_allowed}},
      "mcp__{{ this }}"{{/each}}
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(rm -rf /Users:*)",
      "Bash(rm -rf /System:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(ssh-keygen:*)",
      "Bash(ssh-add:*)",
      "Bash(nc -l:*)",
      "Bash(nc -e:*)",
      "Bash(ncat:*)",
      "Bash(launchctl unload:*)",
      "Bash(launchctl bootout:*)",
      "Bash(launchctl remove:*)",
      "Bash(defaults write:*)",
      "Bash(chmod 777:*)",
      "Bash(chmod -R 777:*)",
      "Bash(chown:*)",
      "Bash(curl --upload-file:*)",
      "Bash(curl -T:*)",
      "Bash(curl --data-binary @/:*)",
      "Bash(curl --data @/:*)",
      "Bash(curl -d @/:*)",
      "Bash(wget --post-file:*)",
      "Bash(wget --post-data:*)",
      "Bash(security:*)",
      "Bash(diskutil:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(chflags:*)",
      "Bash(crontab:*)",
      "Bash(git config --global:*)",
      "Bash(git config --system:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease origin main:*)",
      "Bash(git push --force-with-lease origin master:*)",
      "Bash(git reset --hard origin/main:*)",
      "Bash(git reset --hard origin/master:*)",
      "Bash(git branch -D main:*)",
      "Bash(git branch -D master:*)",
      "Bash(osascript * tell application \"Finder\":*)",
      "Bash(osascript * tell application \"System Events\" to keystroke:*)",
      "Bash(osascript * do shell script:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.yarnrc)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/azure/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Application Support/Google/Chrome/**)",
      "Read(~/Library/Application Support/Slack/**)",
      "Read(~/Library/Application Support/Firefox/**)",
      "Read(~/Library/Cookies/**)",
      "Read(~/Library/Mail/**)",
      "Write(~/.ssh/**)",
      "Write(~/.aws/**)",
      "Write(~/.gnupg/**)",
      "Write(~/.zshrc)",
      "Write(~/.bashrc)",
      "Write(~/.zshenv)",
      "Write(~/.bash_profile)",
      "Write(~/.bash_login)",
      "Write(~/.profile)",
      "Write(~/.zlogin)",
      "Write(~/.zprofile)",
      "Write(~/.zlogout)",
      "Write(~/Library/LaunchAgents/**)",
      "Write(~/Library/LaunchDaemons/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshenv)",
      "Edit(~/.bash_profile)",
      "Edit(~/.bash_login)",
      "Edit(~/.profile)",
      "Edit(~/.zlogin)",
      "Edit(~/.zprofile)",
      "Edit(~/.zlogout)",
      "Edit(~/Library/LaunchAgents/**)",
      "Edit(~/Library/LaunchDaemons/**)"{{#each denied_write_tools}},
      "{{ this }}"{{/each}}
    ]
  }
}
