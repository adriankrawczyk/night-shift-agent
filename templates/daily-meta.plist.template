<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.{{ user_short }}.night-shift-daily-meta</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>{{ install_dir }}/daily-meta.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{ install_dir }}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{ user_home }}</string>
        <key>USER</key>
        <string>{{ user_name }}</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>{{ install_dir }}/runs/daily-meta.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>{{ install_dir }}/runs/daily-meta.stderr.log</string>

    <key>RunAtLoad</key>
    <false/>

    <!-- Fires ~2 hours before main routine (Q7.2 time minus 2h) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>{{ daily_meta_hour }}</integer>
        <key>Minute</key>
        <integer>{{ daily_meta_minute }}</integer>
    </dict>
</dict>
</plist>
