#!/usr/bin/env zsh
# daily-meta.sh — pre-night signal analyzer. Fires ~2 hours before the main
# night-shift run. Reads today's CC sessions + Slack DMs + GH PR activity +
# Linear updates and produces a context report the main agent reads at midnight.
#
# Generated by Night Shift Agent installer (Full tier opt-in).

set -uo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

INSTALL_DIR="{{ install_dir }}"
DM_DIR="$INSTALL_DIR/daily-meta"
TODAY=$(date +%Y-%m-%d)
DM_REPORT="$DM_DIR/${TODAY}.md"
DM_LOG="$INSTALL_DIR/runs/daily-meta-${TODAY}.log"
DM_LOCK="$INSTALL_DIR/.daily-meta-lock"

mkdir -p "$DM_DIR"

# Lock (Pattern P1 — atomic mkdir)
if ! mkdir "$DM_LOCK" 2>/dev/null; then
  echo "daily-meta-lock held — exiting" >> "$DM_LOG"
  exit 1
fi
trap 'rm -rf "$DM_LOCK"' EXIT

emit_log() { echo "$(date -u +%FT%TZ) [daily-meta] $*" | tee -a "$DM_LOG"; }
emit_log "starting"

# Don't run if already produced today's report
if [[ -f "$DM_REPORT" ]] && [[ -s "$DM_REPORT" ]]; then
  emit_log "today's report exists — exiting"
  exit 0
fi

# Resolve timeout (Pattern P7)
if command -v gtimeout >/dev/null 2>&1; then
  TIMEOUT_BIN=gtimeout
elif command -v timeout >/dev/null 2>&1; then
  TIMEOUT_BIN=timeout
else
  TIMEOUT_BIN=""
fi

DM_TIMEOUT_SEC=1800   # 30 min cap for daily-meta

DM_PROMPT="$INSTALL_DIR/daily-meta-prompt.md"

emit_log "Invoking daily-meta-claude"

if [[ -n "$TIMEOUT_BIN" ]]; then
  "$TIMEOUT_BIN" --kill-after=30 "$DM_TIMEOUT_SEC" \
    "$HOME/.local/bin/claude" --print --permission-mode bypassPermissions \
    --add-dir "$INSTALL_DIR" \
    < "$DM_PROMPT" 2>&1 | tee -a "$DM_LOG"
else
  "$HOME/.local/bin/claude" --print --permission-mode bypassPermissions \
    --add-dir "$INSTALL_DIR" \
    < "$DM_PROMPT" 2>&1 | tee -a "$DM_LOG"
fi

DM_EXIT="${pipestatus[1]:-0}"
emit_log "daily-meta-claude exited $DM_EXIT"

# Sanity check the output
if [[ ! -f "$DM_REPORT" ]] || [[ ! -s "$DM_REPORT" ]]; then
  emit_log "WARN: no report file produced — daily-meta failed silently"
else
  emit_log "Report produced at $DM_REPORT ($(wc -l < "$DM_REPORT") lines)"
fi
