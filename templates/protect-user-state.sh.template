#!/usr/bin/env zsh
# protect-user-state.sh — snapshot & restore your project repo around any
# operation that mutates it (e.g., applying a patch to test).
#
# Subcommands:
#   begin <op-id>         Save current state, return checkpoint ID. Mutating
#                         operations safe to perform after.
#   restore <op-id>       Restore the snapshot for the given op-id.
#   snapshot [label]      Passive baseline snapshot (no mutation expected).
#                         Used by run.sh at start of every run.
#   rollback <snap-id>    Restore from a passive snapshot.
#   list-snapshots        List available snapshots.
#   prune                 Delete snapshots older than 14 days.
#   recover-orphan        After a crash mid-mutation, restore from active marker.

set -uo pipefail
# zsh-specific: make arrays 0-indexed (bash-like) and unmatched globs expand
# to empty rather than erroring. Both subcommands below rely on these.
setopt KSH_ARRAYS NULL_GLOB 2>/dev/null || true
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

ROUTINE_DIR="${NIGHT_SHIFT_DIR:-{{ install_dir }}}"
{{#each projects}}
USER_REPO_{{ @index }}="${NIGHT_SHIFT_PROJECT_{{ @index }}:-{{ this.path }}}"
{{/each}}
USER_REPO="${USER_REPO_0}"

# Ordered list of all configured projects. Single-project users get just one
# entry → every per-project loop iterates once → behaves as the single-project
# case. Multi-project users get N entries; subcommands take an optional
# `--project=N` flag (default 0 = primary).
ALL_USER_REPOS=({{#each projects}}"$USER_REPO_{{ @index }}" {{/each}})

CHECKPOINTS_DIR="$ROUTINE_DIR/checkpoints"
ACTIVE_MARKER="$CHECKPOINTS_DIR/.active"
mkdir -p "$CHECKPOINTS_DIR"

# NULL_GLOB safety: when zsh expands an unmatched glob to nothing and we pass
# the empty expansion to `ls -td`, ls defaults to the current directory and we
# get a phantom "." match. This helper takes a glob *pattern as a string* and
# expands it via zsh's `${~var}` (force-glob-on-expansion) so the caller can
# build the pattern with normal interpolation. Returns the most-recent matching
# dir (by mtime) if any exist, else nothing.
_find_recent_match() {
  # shellcheck disable=SC2206,SC2296  # ${~1} is zsh-specific glob-on-expand
  local matches=( ${~1} )
  if (( ${#matches[@]} > 0 )) && [[ -d "${matches[0]}" ]]; then
    ls -td "${matches[@]}" 2>/dev/null | head -1
  fi
}

# Per-project subdir naming: `p0/`, `p1/`, …. Files inside are the same
# layout as the single-project case (orig_head.txt, orig_ref.txt, diff.patch,
# untracked.txt, status_hash.txt). Restore/rollback iterate p<N> dirs in
# numeric order so primary always restores first (failures on secondary
# don't block primary recovery).
project_subdir_name() {
  printf 'p%s' "$1"
}

filter_untracked_by_size() {
  local list="$1" filtered="$1.filtered" excluded="$1.excluded"
  : > "$filtered"
  : > "$excluded"
  while IFS= read -r rel; do
    [[ -z "$rel" ]] && continue
    local full="$USER_REPO/$rel"
    [[ ! -f "$full" ]] && continue
    local sz; sz=$(stat -f %z "$full" 2>/dev/null || echo 0)
    if (( sz > 10485760 )); then  # 10MB ceiling
      printf '%s\t%s bytes\n' "$rel" "$sz" >> "$excluded"
    else
      printf '%s\n' "$rel" >> "$filtered"
    fi
  done < "$list"
}

# Resolve --project=<N> flag (or positional default 0) and validate range.
# Sets $RESOLVED_PROJECT_IDX and $RESOLVED_PROJECT_REPO. Other args left untouched
# via the caller re-reading "$@" after this consumes the flag.
_resolve_project_flag() {
  RESOLVED_PROJECT_IDX=0
  local arg
  REMAINING_ARGS=()
  for arg in "$@"; do
    case "$arg" in
      --project=*) RESOLVED_PROJECT_IDX="${arg#--project=}" ;;
      *) REMAINING_ARGS+=("$arg") ;;
    esac
  done
  if ! [[ "$RESOLVED_PROJECT_IDX" =~ ^[0-9]+$ ]]; then
    echo "ERROR: --project=<N> must be a non-negative integer, got '$RESOLVED_PROJECT_IDX'" >&2
    return 2
  fi
  if (( RESOLVED_PROJECT_IDX >= ${#ALL_USER_REPOS[@]} )); then
    echo "ERROR: --project=$RESOLVED_PROJECT_IDX out of range (have ${#ALL_USER_REPOS[@]} projects: indices 0..$((${#ALL_USER_REPOS[@]} - 1)))" >&2
    return 2
  fi
  RESOLVED_PROJECT_REPO="${ALL_USER_REPOS[$RESOLVED_PROJECT_IDX]}"
}

# Begin a checkpoint on ONE project, writing per-project state under $dir/p<N>/.
# Multiple sequential begins on different projects under the same <id> accumulate
# entries in $dir (cmd_restore iterates them all at restore time).
_begin_one_project() {
  local id="$1" idx="$2" repo="$3" dir="$4"
  local pdir
  pdir="$dir/$(project_subdir_name "$idx")"
  mkdir -p "$pdir"

  if ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
    echo "non-git" > "$pdir/skip.txt"
    echo "$repo" > "$pdir/repo_path.txt"
    echo "  p$idx: skipped (non-git)"
    return 0
  fi

  git -C "$repo" rev-parse HEAD > "$pdir/orig_head.txt" 2>/dev/null
  git -C "$repo" symbolic-ref --short HEAD > "$pdir/orig_ref.txt" 2>/dev/null || echo "DETACHED" > "$pdir/orig_ref.txt"
  echo "$repo" > "$pdir/repo_path.txt"

  local stash_msg
  stash_msg="night-shift-checkpoint-${id}-p${idx}-$(date -u +%FT%TZ)"
  if git -C "$repo" stash push --include-untracked --quiet -m "$stash_msg" 2>>"$pdir/log.txt"; then
    echo "$stash_msg" > "$pdir/stash_msg.txt"
  else
    echo "no-stash-needed" > "$pdir/stash_msg.txt"
  fi
  echo "  p$idx: checkpoint set ($repo)"
}

cmd_begin() {
  _resolve_project_flag "$@" || return 2
  set -- "${REMAINING_ARGS[@]}"
  if [[ $# -lt 1 ]]; then
    echo "Usage: protect-user-state.sh begin <label> [--project=N]" >&2
    echo "  <label>: short identifier for this checkpoint (e.g. bug-id, pr-number)" >&2
    echo "  --project=N (default 0): which configured project to begin on" >&2
    return 2
  fi
  local id="$1"
  local idx="$RESOLVED_PROJECT_IDX"
  local repo="$RESOLVED_PROJECT_REPO"

  # Find or create the checkpoint dir. If a prior `begin` already ran with this
  # id (e.g. user is begin'ing a second project under the same bug id), reuse
  # that dir; otherwise create a new one.
  local dir
  dir=$(_find_recent_match "$CHECKPOINTS_DIR/begin-${id}-*")
  if [[ -z "$dir" || ! -d "$dir" ]]; then
    dir="$CHECKPOINTS_DIR/begin-$id-$(date -u +%FT%H%M%S)"
    mkdir -p "$dir"
  fi

  _begin_one_project "$id" "$idx" "$repo" "$dir"

  # Active marker: track project list so cmd_restore knows what to undo even
  # if invoked from a fresh shell.
  cat > "$ACTIVE_MARKER" <<EOF
{
  "checkpoint_id": "$id",
  "checkpoint_dir": "$dir",
  "begun_at": "$(date -u +%FT%TZ)"
}
EOF
  echo "checkpoint_id=$id"
  echo "checkpoint_dir=$dir"
  echo "checkpoint_project_idx=$idx"
}

# Restore ONE project from $pdir. Mirrors the legacy single-project flow but
# scoped to whichever repo's snapshot lives in $pdir.
_restore_one_project() {
  local pdir="$1" idx="$2"
  [[ -f "$pdir/skip.txt" ]] && { echo "  p$idx: skipped (non-git)"; return 0; }
  [[ ! -f "$pdir/orig_head.txt" ]] && { echo "  p$idx: missing checkpoint data" >&2; return 1; }

  local repo orig_ref orig_head stash_msg
  repo=$(cat "$pdir/repo_path.txt" 2>/dev/null)
  orig_ref=$(cat "$pdir/orig_ref.txt" 2>/dev/null)
  orig_head=$(cat "$pdir/orig_head.txt" 2>/dev/null)
  stash_msg=$(cat "$pdir/stash_msg.txt" 2>/dev/null)
  [[ -z "$repo" || ! -d "$repo" ]] && { echo "  p$idx: repo path missing" >&2; return 1; }

  if [[ "$orig_ref" != "DETACHED" ]]; then
    git -C "$repo" checkout --quiet "$orig_ref" 2>>"$pdir/log.txt" || \
      git -C "$repo" checkout --detach --quiet "$orig_head" 2>>"$pdir/log.txt"
  else
    git -C "$repo" checkout --detach --quiet "$orig_head" 2>>"$pdir/log.txt"
  fi
  git -C "$repo" reset --hard --quiet "$orig_head" 2>>"$pdir/log.txt"

  if [[ "$stash_msg" != "no-stash-needed" && -n "$stash_msg" ]]; then
    local stash_ref
    stash_ref=$(git -C "$repo" stash list | grep -F "$stash_msg" | head -1 | cut -d: -f1)
    if [[ -n "$stash_ref" ]]; then
      if git -C "$repo" stash apply --quiet "$stash_ref" 2>>"$pdir/log.txt"; then
        git -C "$repo" stash drop --quiet "$stash_ref" 2>>"$pdir/log.txt"
      else
        echo "  p$idx: WARN stash apply conflicted — KEPT in stash list for manual recovery"
        return 2
      fi
    fi
  fi
  echo "  p$idx: restored ($repo)"
}

cmd_restore() {
  if [[ $# -lt 1 ]]; then
    echo "Usage: protect-user-state.sh restore <checkpoint-id>" >&2
    echo "  <checkpoint-id>: the id from a prior 'begin' call (or 'latest' for most recent)" >&2
    return 2
  fi
  local id="$1"
  local dir
  if [[ "$id" == "latest" ]]; then
    dir=$(_find_recent_match "$CHECKPOINTS_DIR/begin-*")
  else
    dir=$(_find_recent_match "$CHECKPOINTS_DIR/begin-${id}-*")
  fi
  if [[ -z "$dir" || ! -d "$dir" ]]; then
    echo "No checkpoint for id $id" >&2
    return 1
  fi

  echo "restoring from $dir:"
  local any_fail=0

  # New layout: $dir/p<N>/ subdirs per project. Iterate numerically.
  # shellcheck disable=SC2206  # intentional word splitting on glob expansion
  local pdirs=( "$dir"/p* )
  if (( ${#pdirs[@]} > 0 )) && [[ -d "${pdirs[0]}" ]]; then
    for pdir in "${pdirs[@]}"; do
      [[ -d "$pdir" ]] || continue
      local pidx="${pdir##*/p}"
      _restore_one_project "$pdir" "$pidx" || any_fail=1
    done
  else
    # Legacy single-project layout: state files directly in $dir/. Treat as p0.
    if [[ -f "$dir/orig_head.txt" ]]; then
      local repo="$USER_REPO_0" stash_msg
      stash_msg=$(cat "$dir/stash_msg.txt" 2>/dev/null)
      local orig_ref orig_head
      orig_ref=$(cat "$dir/orig_ref.txt"); orig_head=$(cat "$dir/orig_head.txt")
      if [[ "$orig_ref" != "DETACHED" ]]; then
        git -C "$repo" checkout --quiet "$orig_ref" 2>>"$dir/log.txt" || \
          git -C "$repo" checkout --detach --quiet "$orig_head" 2>>"$dir/log.txt"
      else
        git -C "$repo" checkout --detach --quiet "$orig_head" 2>>"$dir/log.txt"
      fi
      git -C "$repo" reset --hard --quiet "$orig_head" 2>>"$dir/log.txt"
      if [[ -n "$stash_msg" && "$stash_msg" != "no-stash-needed" ]]; then
        local stash_ref
        stash_ref=$(git -C "$repo" stash list | grep -F "$stash_msg" | head -1 | cut -d: -f1)
        [[ -n "$stash_ref" ]] && git -C "$repo" stash apply --quiet "$stash_ref" && git -C "$repo" stash drop --quiet "$stash_ref"
      fi
      echo "  legacy single-project: restored ($repo)"
    fi
  fi

  rm -f "$ACTIVE_MARKER"
  [[ "$any_fail" == "1" ]] && echo "WARN: some projects failed to restore (see lines above)" >&2
  echo "done"
}

# Snapshot ONE project to a $dir/p<N>/ subdir. Used by cmd_snapshot per project.
_snapshot_one_project() {
  local idx="$1" repo="$2" parent_dir="$3"
  local pdir
  pdir="$parent_dir/$(project_subdir_name "$idx")"
  mkdir -p "$pdir"

  if ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
    echo "non-git" > "$pdir/skip.txt"
    return 0
  fi

  local cur_head cur_ref cur_status_hash
  cur_head=$(git -C "$repo" rev-parse HEAD 2>/dev/null)
  cur_ref=$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null || echo "DETACHED")
  cur_status_hash=$(git -C "$repo" status --porcelain | shasum | cut -d' ' -f1)

  echo "$cur_head" > "$pdir/orig_head.txt"
  echo "$cur_ref" > "$pdir/orig_ref.txt"
  echo "$cur_status_hash" > "$pdir/status_hash.txt"
  echo "$repo" > "$pdir/repo_path.txt"
  git -C "$repo" status --porcelain > "$pdir/status.txt"
  git -C "$repo" diff HEAD > "$pdir/diff.patch" 2>/dev/null
  git -C "$repo" ls-files --others --exclude-standard > "$pdir/untracked.txt"

  # Size-filter using $repo-local paths (the global filter_untracked_by_size
  # is USER_REPO-bound; rebuild minimal logic here)
  local filtered="$pdir/untracked.txt.filtered"
  local excluded="$pdir/untracked.txt.excluded"
  : > "$filtered"; : > "$excluded"
  while IFS= read -r rel; do
    [[ -z "$rel" ]] && continue
    local full="$repo/$rel"
    [[ ! -f "$full" ]] && continue
    local sz; sz=$(stat -f %z "$full" 2>/dev/null || echo 0)
    if (( sz > 10485760 )); then
      printf '%s\t%s bytes\n' "$rel" "$sz" >> "$excluded"
    else
      printf '%s\n' "$rel" >> "$filtered"
    fi
  done < "$pdir/untracked.txt"
}

cmd_snapshot() {
  local label="${1:-baseline}"

  # Dedup against most-recent snapshot. Only checks PRIMARY project's hash
  # (the common single-project case stays fast; multi-project edge eats one
  # extra dir on a no-change rerun, which is harmless).
  local cur_head cur_ref cur_status_hash
  cur_head=$(git -C "$USER_REPO" rev-parse HEAD 2>/dev/null)
  cur_ref=$(git -C "$USER_REPO" symbolic-ref --short HEAD 2>/dev/null || echo "DETACHED")
  cur_status_hash=$(git -C "$USER_REPO" status --porcelain | shasum | cut -d' ' -f1)

  local recent_dir
  recent_dir=$(_find_recent_match "$CHECKPOINTS_DIR/snap-*")
  if [[ -n "$recent_dir" && -f "$recent_dir/p0/orig_head.txt" ]]; then
    local r_head r_ref r_status_hash
    r_head=$(cat "$recent_dir/p0/orig_head.txt")
    r_ref=$(cat "$recent_dir/p0/orig_ref.txt")
    r_status_hash=$(cat "$recent_dir/p0/status_hash.txt" 2>/dev/null)
    local r_ts; r_ts=$(stat -f %m "$recent_dir" 2>/dev/null || echo 0)
    local age=$(( $(date +%s) - r_ts ))
    if [[ "$r_head" == "$cur_head" && "$r_ref" == "$cur_ref" && "$r_status_hash" == "$cur_status_hash" ]] && (( age < 1800 )); then
      echo "snap-id=$(basename "$recent_dir")"
      return 0
    fi
  fi

  local dir
  dir="$CHECKPOINTS_DIR/snap-${label}-$(date -u +%FT%H%M%S)"
  mkdir -p "$dir"

  # Snapshot every configured USER_REPO_N independently. Primary failure
  # aborts (single-project users get same exit codes as before); secondary
  # failures log + continue (their rollback won't work but primary's will).
  local idx=0
  for repo in "${ALL_USER_REPOS[@]}"; do
    if ! _snapshot_one_project "$idx" "$repo" "$dir"; then
      if [[ "$idx" == "0" ]]; then
        echo "FATAL: primary project snapshot failed" >&2
        return 1
      fi
      echo "WARN: snapshot for project[$idx] ($repo) failed — continuing" >&2
    fi
    idx=$((idx + 1))
  done

  echo "snap-id=$(basename "$dir")"
}

# Roll back ONE project from a $dir/p<N>/ subdir. Returns 0 on success,
# non-zero on hard failure (caller decides whether to abort the run).
_rollback_one_project() {
  local pdir="$1" idx="$2"
  [[ -f "$pdir/skip.txt" ]] && { echo "  p$idx: skipped (non-git)"; return 0; }
  [[ ! -f "$pdir/orig_head.txt" ]] && { echo "  p$idx: missing snapshot data" >&2; return 1; }

  local repo orig_head orig_ref
  repo=$(cat "$pdir/repo_path.txt" 2>/dev/null)
  [[ -z "$repo" || ! -d "$repo" ]] && { echo "  p$idx: repo path not readable" >&2; return 1; }
  orig_head=$(cat "$pdir/orig_head.txt")
  orig_ref=$(cat "$pdir/orig_ref.txt")

  if [[ "$orig_ref" != "DETACHED" ]]; then
    git -C "$repo" checkout --quiet "$orig_ref" 2>/dev/null || \
      git -C "$repo" checkout --detach --quiet "$orig_head" 2>/dev/null || return 1
  else
    git -C "$repo" checkout --detach --quiet "$orig_head" 2>/dev/null || return 1
  fi
  git -C "$repo" reset --hard --quiet "$orig_head" 2>/dev/null || return 1

  if [[ -s "$pdir/diff.patch" ]]; then
    git -C "$repo" apply "$pdir/diff.patch" 2>/dev/null || \
      echo "  p$idx: WARN diff.patch did not re-apply cleanly"
  fi
  echo "  p$idx: rolled back ($repo)"
}

cmd_rollback() {
  local id="${1:-latest}"
  local dir
  if [[ "$id" == "latest" ]]; then
    dir=$(_find_recent_match "$CHECKPOINTS_DIR/snap-*")
  else
    dir="$CHECKPOINTS_DIR/$id"
  fi
  if [[ -z "$dir" || ! -d "$dir" ]]; then
    echo "No snapshot found" >&2
    return 1
  fi

  # Backward-compat: old single-project snapshots stored files at $dir/
  # (no p0/ subdir). Detect + handle inline.
  if [[ -f "$dir/orig_head.txt" && ! -d "$dir/p0" ]]; then
    echo "Legacy single-project snapshot detected — rolling back primary only"
    local orig_head orig_ref
    orig_head=$(cat "$dir/orig_head.txt")
    orig_ref=$(cat "$dir/orig_ref.txt")
    if [[ "$orig_ref" != "DETACHED" ]]; then
      git -C "$USER_REPO" checkout --quiet "$orig_ref"
    else
      git -C "$USER_REPO" checkout --detach --quiet "$orig_head"
    fi
    git -C "$USER_REPO" reset --hard --quiet "$orig_head"
    [[ -s "$dir/diff.patch" ]] && \
      { git -C "$USER_REPO" apply "$dir/diff.patch" 2>/dev/null || echo "WARN: diff didn't re-apply"; }
    echo "rolled back to $dir"
    return 0
  fi

  # New layout: iterate p0/, p1/, … in numeric order.
  echo "rolling back from $dir:"
  local any_fail=0
  # shellcheck disable=SC2206  # intentional word splitting on glob expansion
  local pdirs=( "$dir"/p* )
  if (( ${#pdirs[@]} > 0 )) && [[ -d "${pdirs[0]}" ]]; then
    for pdir in "${pdirs[@]}"; do
      [[ -d "$pdir" ]] || continue
      local idx="${pdir##*/p}"
      if ! _rollback_one_project "$pdir" "$idx"; then
        any_fail=1
        [[ "$idx" == "0" ]] && { echo "FATAL: primary rollback failed" >&2; return 1; }
      fi
    done
  fi
  [[ "$any_fail" == "1" ]] && echo "WARN: at least one secondary rollback failed (see lines above)"
  echo "done"
}

cmd_list_snapshots() {
  # shellcheck disable=SC2206  # intentional word splitting on glob expansion
  local snaps=( "$CHECKPOINTS_DIR"/snap-* )
  (( ${#snaps[@]} == 0 )) && return 0
  [[ -d "${snaps[0]}" ]] || return 0
  ls -td "${snaps[@]}" 2>/dev/null | head -20 | while read -r d; do
    local ts; ts=$(stat -f %Sm -t '%Y-%m-%d %H:%M' "$d" 2>/dev/null)
    echo "$(basename "$d")  $ts"
  done
}

cmd_prune() {
  find "$CHECKPOINTS_DIR" -maxdepth 1 -name "snap-*" -type d -mtime +14 -exec rm -rf {} \; 2>/dev/null || true
  find "$CHECKPOINTS_DIR" -maxdepth 1 -name "begin-*" -type d -mtime +14 -exec rm -rf {} \; 2>/dev/null || true
}

cmd_recover_orphan() {
  [[ ! -f "$ACTIVE_MARKER" ]] && { echo "no active marker"; return 0; }
  local id; id=$(jq -r .checkpoint_id "$ACTIVE_MARKER")
  echo "orphan checkpoint detected — restoring id=$id"
  cmd_restore "$id"
}

# cmd_apply <checkpoint-id> <patch-file> [--project=N]
# Applies a test patch on top of origin/main (detached) inside a previously-
# begun checkpoint. cmd_restore returns to the pre-apply state. Referenced
# by prompt.md ("All mutations happen via protect-user-state.sh apply/restore");
# without this, the patch-test-restore loop is broken.
#
# Multi-project: pass `--project=N` to apply the patch to a non-primary repo
# from ALL_USER_REPOS (default 0 = primary). The flag's position is free —
# anywhere in the argv works, since _resolve_project_flag strips it first.
cmd_apply() {
  _resolve_project_flag "$@" || return 2
  set -- "${REMAINING_ARGS[@]}"
  local id="${1:-}"
  local patch="${2:-}"
  [[ -z "$id" || -z "$patch" ]] && {
    echo "usage: protect-user-state.sh apply <id> <patch-file> [--project=N]" >&2
    return 2
  }
  local dir="$CHECKPOINTS_DIR/$id"
  local repo="$RESOLVED_PROJECT_REPO"
  local idx="$RESOLVED_PROJECT_IDX"

  [[ -d "$dir" ]] || { echo "FATAL: checkpoint dir not found: $dir" >&2; return 2; }
  [[ -f "$patch" ]] || { echo "FATAL: patch file not found: $patch" >&2; return 2; }
  [[ -d "$repo" ]] || { echo "FATAL: project[$idx] repo not found: $repo" >&2; return 2; }

  cd "$repo" || return 2

  # Detach to origin/main so the patch lands on a known baseline (not whatever
  # branch the user happened to leave checked out)
  git fetch origin main --quiet 2>>"$dir/log.txt" || true
  git checkout --detach origin/main --quiet 2>>"$dir/log.txt" || {
    echo "FATAL: checkout origin/main failed in $repo" >&2
    return 2
  }
  if ! git apply "$patch" 2>>"$dir/log.txt"; then
    echo "ERROR: patch did not apply cleanly to project[$idx] ($repo) — see $dir/log.txt" >&2
    return 1
  fi
  echo "applied test patch from $patch on origin/main of project[$idx] ($repo)"
}

case "${1:-}" in
  begin)    shift; cmd_begin "$@" ;;
  apply)    shift; cmd_apply "$@" ;;
  restore)  shift; cmd_restore "$@" ;;
  snapshot) shift; cmd_snapshot "$@" ;;
  rollback) shift; cmd_rollback "$@" ;;
  list-snapshots) shift; cmd_list_snapshots "$@" ;;
  prune)    cmd_prune ;;
  recover-orphan) cmd_recover_orphan ;;
  *)
    echo "Usage: protect-user-state.sh {begin|apply|restore|snapshot|rollback|list-snapshots|prune|recover-orphan}" >&2
    echo "" >&2
    echo "  begin <bug-id> [--project=N]     — create live-repro checkpoint (project default 0)" >&2
    echo "  apply <checkpoint-id> <patch> [--project=N]  — apply patch on origin/main inside checkpoint" >&2
    echo "  restore <checkpoint-id>          — restore from live-repro checkpoint (all projects)" >&2
    echo "  snapshot [label]                 — pre-run baseline snapshot" >&2
    echo "  rollback <snap-id>               — roll back to baseline snapshot" >&2
    echo "  list-snapshots                   — list recent baseline snapshots" >&2
    echo "  prune                            — delete snapshots older than 14 days" >&2
    echo "  recover-orphan                   — recover from interrupted live-repro" >&2
    exit 2
    ;;
esac
