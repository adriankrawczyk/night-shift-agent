#!/usr/bin/env bash
# verify-invariants.sh — defense-layer presence gate (generated by the Night
# Shift Agent installer). For each documented defense layer, assert its marker is
# still present in the rendered run.sh / settings.json. This is the AUTO-MERGE
# GATE for the RUN-HEALTH track: the meta-agent may auto-merge a run-health fix
# ONLY when this exits 0 afterward, and daily-meta runs it as a pre-night REVERT
# GUARD (a layer that got refactored/reverted away WILL break tonight).
#
# The seed invariant set below is conditioned on which resilience features this
# install selected. The catalog (RUN-HEALTH.md) GROWS: when the meta-agent learns
# a novel failure it appends a check here + a catalog section, in one PR.
#
# Usage: verify-invariants.sh [--for RHNN] [--list] [--json]
# Exit 0 = all present, 2 = a layer was reverted/missing, 3 = bad install dir.
set -uo pipefail
ROUTINE_DIR="${NIGHT_SHIFT_DIR:-{{ install_dir }}}"
cd "$ROUTINE_DIR" || { echo "verify-invariants: cannot cd $ROUTINE_DIR" >&2; exit 3; }

FILTER_RH=""
EMIT_JSON=0
LIST_ONLY=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --for) FILTER_RH="$2"; shift 2 ;;
    --json) EMIT_JSON=1; shift ;;
    --list) LIST_ONLY=1; shift ;;
    *) shift ;;
  esac
done

FAILS=0
PASSES=0
RESULTS=""

check() { # id file pattern min rh
  local id="$1" file="$2" pat="$3" min="$4" rh="$5" n
  if [[ -n "$FILTER_RH" && "$rh" != *"$FILTER_RH"* ]]; then return; fi
  if [[ "$LIST_ONLY" -eq 1 ]]; then echo "$id ($rh) <- $file"; return; fi
  if [[ ! -f "$file" ]]; then
    RESULTS+="FAIL $id ($rh): $file missing"$'\n'; FAILS=$((FAILS+1)); return
  fi
  n=$(grep -cE -- "$pat" "$file" 2>/dev/null || true)
  if (( n >= min )); then
    RESULTS+="PASS $id ($rh)"$'\n'; PASSES=$((PASSES+1))
  else
    RESULTS+="FAIL $id ($rh): /$pat/ matched $n (< $min) in $file"$'\n'; FAILS=$((FAILS+1))
  fi
}

# === Seed invariants (universal — present in any install) ===
check lock_present        run.sh 'acquire_lock'              1 RH20
check cleanup_trap        run.sh 'trap .{0,4}cleanup'        1 RH20
check hard_wall_present   run.sh 'CLAUDE_HARD_TIMEOUT_SEC'   1 RH22
check hard_wall_enforced  run.sh '\-\-kill-after|SIG.?\{?ALRM' 1 RH22
check ratelimit_regex     run.sh 'hit your limit'            1 RH06
check sighup_survival     run.sh "trap '' HUP"              1 RH05

# === Conditional invariants (only when the feature was installed) ===
{{#if resilience_caffeinate}}
check caffeinate_killed   run.sh 'CAFFEINATE_PID'            1 RH21
{{/if}}
{{#if resilience_stall_watchdog}}
check stall_watchdog      run.sh 'start_stall_watchdog'      1 RH23
check first_activity      run.sh 'FIRST_ACTIVITY_DEADLINE'   1 RH23
{{/if}}
{{#if resilience_abs_wall_timer}}
check abs_wall_timer      run.sh 'abs_wall_suicide'          1 RH19
{{/if}}
{{#if resilience_api_gate}}
check api_gate            run.sh 'api_health_gate'           1 RH18
{{/if}}
{{#if uses_mcp_config}}
check mcp_config_wired    run.sh '\-\-mcp-config'            1 RH08
{{/if}}
{{#if resilience_network_recovery}}
check network_recovery    run.sh 'networksetup'              1 RH24
{{/if}}
{{#if snapshot_user_repo}}
check snapshot_present     run.sh 'protect-user-state'        1 RH25
{{/if}}

if [[ "$LIST_ONLY" -eq 1 ]]; then exit 0; fi

if [[ "$EMIT_JSON" -eq 1 ]]; then
  printf '{"passes":%d,"fails":%d}\n' "$PASSES" "$FAILS"
else
  printf '%s' "$RESULTS"
fi

if (( FAILS > 0 )); then
  echo "verify-invariants: $FAILS invariant(s) FAILED — a defense layer was reverted or never rendered" >&2
  exit 2
fi
echo "verify-invariants: all $PASSES invariant(s) present"
exit 0
