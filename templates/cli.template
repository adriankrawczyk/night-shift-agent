#!/usr/bin/env zsh
# night-shift — CLI helper for the Night Shift Agent installed at {{ install_dir }}
#
# Subcommands:
#   night-shift brief [--date YYYY-MM-DD]   Open the latest (or specified) morning brief
#   night-shift apply <id>      Apply a patch from <install>/patches/ by partial id match
#   night-shift apply <id> --force   Apply even if working tree is dirty
#   night-shift run [--dry-run]      Trigger a manual run (same as scheduled)
#   night-shift status              Show last run status + next scheduled run
#   night-shift logs [N]            Tail last N lines of latest log (default 50)
#   night-shift triage              Print triage report (last 7 runs)
#   night-shift restore [snap-id]   Roll back user repo to last-night snapshot
#   night-shift doctor              Runtime health check (launchd, claude, MCPs, disk, logs)
#   night-shift uninstall [--yes]   Unload launchd job + remove plists (keeps install dir)
#   night-shift help

set -uo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# Stash script path BEFORE any function call — in zsh, $0 inside a function
# resolves to the function name, not the script path (unless FUNCTION_ARGZERO
# option is set, which we can't rely on across the user's shell config).
SCRIPT_PATH="$0"

ROUTINE_DIR="${NIGHT_SHIFT_DIR:-{{ install_dir }}}"
{{#each projects}}
USER_REPO_{{ @index }}="${NIGHT_SHIFT_PROJECT_{{ @index }}:-{{ this.path }}}"
{{/each}}
USER_REPO="${USER_REPO_0}"

PATCHES_DIR="$ROUTINE_DIR/patches"
RUNS_DIR="$ROUTINE_DIR/runs"

usage() {
  sed -n '4,14p' "$SCRIPT_PATH" | sed 's/^# \{0,1\}//'
}

# Find a patch by partial id match (zsh case-insensitive ${var:l})
find_patch() {
  local id_l="${1:l}"
  local matches=()
  # Search all patches under <patches>/YYYY-MM-DD/
  while IFS= read -r p; do
    local base="${p:t:l}"
    if [[ "$base" == *"$id_l"* ]]; then
      matches+=("$p")
    fi
  done < <(find "$PATCHES_DIR" -name '*.patch' 2>/dev/null | sort -r)
  if [[ ${#matches[@]} -eq 0 ]]; then
    echo "No patch matching '$1' under $PATCHES_DIR" >&2
    return 1
  elif [[ ${#matches[@]} -gt 1 ]]; then
    echo "Multiple patches match '$1':" >&2
    printf '  %s\n' "${matches[@]}" >&2
    return 2
  fi
  echo "${matches[1]}"
}

cmd_brief() {
  local date=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --date) date="${2:-}"; shift 2 ;;
      -h|--help) echo "Usage: night-shift brief [--date YYYY-MM-DD]"; return 0 ;;
      *) echo "Unknown arg: $1" >&2; return 2 ;;
    esac
  done

  local brief_file=""
  if [[ -n "$date" ]]; then
    brief_file="$RUNS_DIR/$date/brief.md"
    [[ -f "$brief_file" ]] || { echo "No brief found at $brief_file" >&2; return 1; }
  else
    # Latest brief across all date dirs (lexical sort works for YYYY-MM-DD)
    brief_file=$(find "$RUNS_DIR" -maxdepth 2 -name 'brief.md' 2>/dev/null | sort -r | head -1)
    [[ -n "$brief_file" ]] || { echo "No briefs found under $RUNS_DIR. Has the night agent run yet?" >&2; return 1; }
  fi

  echo "Opening: $brief_file"
  if [[ -n "${EDITOR:-}" ]] && [[ "${NIGHT_SHIFT_BRIEF_USE_EDITOR:-1}" == "1" ]]; then
    "$EDITOR" "$brief_file"
  else
    open "$brief_file"
  fi
}

cmd_apply() {
  if [[ $# -lt 1 ]]; then
    echo "Usage: night-shift apply <patch-id> [--force]" >&2
    echo "  <patch-id>: partial id match (e.g. 'pr-123' or just '123')" >&2
    echo "  --force:    apply even if working tree is dirty" >&2
    return 2
  fi
  local id="$1"
  local force=0
  [[ "${2:-}" == "--force" ]] && force=1

  local patch_file
  patch_file=$(find_patch "$id") || return $?
  echo "Applying: $patch_file"

  if [[ $force -eq 0 ]]; then
    if ! git -C "$USER_REPO" diff --quiet || ! git -C "$USER_REPO" diff --cached --quiet; then
      echo "ERROR: working tree is dirty. Use --force to apply anyway." >&2
      git -C "$USER_REPO" status --short
      return 1
    fi
  fi

  if git -C "$USER_REPO" apply --check "$patch_file" 2>/dev/null; then
    git -C "$USER_REPO" apply "$patch_file" && echo "✓ Applied successfully"
  else
    echo "Patch doesn't apply cleanly. Trying 3-way merge..."
    git -C "$USER_REPO" apply --3way "$patch_file"
  fi
}

cmd_run() {
  local args=""
  [[ "${1:-}" == "--dry-run" ]] && args="--dry-run"
  "$ROUTINE_DIR/run.sh" $args
}

cmd_status() {
  local latest_log
  latest_log=$(ls -t "$RUNS_DIR"/*.log 2>/dev/null | head -1)
  if [[ -z "$latest_log" ]]; then
    echo "No runs yet."
    return 0
  fi
  local last_date; last_date=$(basename "$latest_log" .log)
  echo "Last run: $last_date"
  # Tail relevant status
  grep -E '(Run finished|FATAL|delivery_complete|skip)' "$latest_log" | tail -5
  # Next scheduled run (from launchd plist)
  local plist="$HOME/Library/LaunchAgents/com.{{ user_short }}.night-shift-routine.plist"
  if [[ -f "$plist" ]]; then
    echo ""
    echo "Schedule:"
    /usr/libexec/PlistBuddy -c "Print StartCalendarInterval" "$plist" 2>/dev/null | head -20
  fi
}

cmd_logs() {
  local n="${1:-50}"
  local latest_log
  latest_log=$(ls -t "$RUNS_DIR"/*.log 2>/dev/null | head -1)
  [[ -z "$latest_log" ]] && { echo "No logs yet."; return 0; }
  tail -n "$n" "$latest_log"
}

cmd_triage() {
  "$ROUTINE_DIR/triage.sh" 7
}

cmd_restore() {
  local id="${1:-latest}"
  "$ROUTINE_DIR/protect-user-state.sh" rollback "$id"
}

cmd_doctor() {
  local fails=0
  local warns=0
  local ok_count=0
  local p_ok="\033[32m✓\033[0m"
  local p_fail="\033[31m✗\033[0m"
  local p_warn="\033[33m!\033[0m"

  check_ok()   { ok_count=$((ok_count+1)); printf "  $p_ok %s\n" "$*"; }
  check_warn() { warns=$((warns+1));       printf "  $p_warn %s\n" "$*"; }
  check_fail() { fails=$((fails+1));       printf "  $p_fail %s\n" "$*"; }

  echo "Night Shift Agent — doctor"
  echo ""

  echo "## Binaries"
  for bin in claude jq git gh; do
    if command -v "$bin" >/dev/null 2>&1; then check_ok  "$bin: $(command -v $bin)"
    else                                       check_fail "$bin: missing"; fi
  done
{{#if resilience_caffeinate}}
  if command -v caffeinate >/dev/null 2>&1; then check_ok "caffeinate"
  else                                            check_warn "caffeinate missing — sleep prevention disabled"; fi
{{/if}}

  echo ""
  echo "## Install integrity"
  for f in prompt.md run.sh settings.json triage.sh; do
    if [[ -f "$ROUTINE_DIR/$f" ]]; then check_ok "$f present"
    else                                check_fail "$f missing in $ROUTINE_DIR"; fi
  done
  if [[ -x "$ROUTINE_DIR/run.sh" ]]; then check_ok "run.sh executable"
  else                                     check_fail "run.sh not executable (chmod +x)"; fi

  echo ""
  echo "## Schedule"
{{#if has_specific_days}}
  local plist="$HOME/Library/LaunchAgents/com.{{ user_short }}.night-shift-routine.plist"
  if [[ -f "$plist" ]]; then
    check_ok "launchd plist installed at $plist"
    if launchctl list 2>/dev/null | grep -q 'com.{{ user_short }}.night-shift-routine'; then
      check_ok "launchd job is loaded"
    else
      check_warn "launchd plist exists but isn't loaded (launchctl bootstrap gui/\$(id -u) \"$plist\")"
    fi
  else
    check_fail "launchd plist missing — re-run wizard or copy template"
  fi
{{else}}
  check_ok "execution_mode={{ execution_mode }} — no launchd schedule expected"
{{/if}}

  echo ""
  echo "## claude CLI auth"
  if claude --version >/dev/null 2>&1; then
    check_ok "claude responds ($(claude --version 2>&1 | head -1))"
  else
    check_fail "claude --version failed — re-login needed"
  fi

{{#if has_github_remote}}
  echo ""
  echo "## gh CLI auth"
  if command -v gh >/dev/null 2>&1; then
    if gh auth status >/dev/null 2>&1; then
      local gh_user
      gh_user=$(gh api user --jq .login 2>/dev/null || echo "?")
      check_ok "gh authed as $gh_user"
    else
      check_fail "gh not authenticated — run: gh auth login"
    fi
  else
    check_fail "gh missing — PR-delivery recipes will fail without it"
  fi
{{/if}}

  echo ""
  echo "## MCP connectivity"
  if claude mcp list 2>/dev/null | grep -q '✓ Connected'; then
    local connected needs_auth
    connected=$(claude mcp list 2>/dev/null | grep -c '✓ Connected')
    needs_auth=$(claude mcp list 2>/dev/null | grep -c 'Needs authentication')
    check_ok "$connected MCP(s) connected"
    [[ $needs_auth -gt 0 ]] && check_warn "$needs_auth MCP(s) need re-authentication"
  else
    check_warn "no MCPs report Connected — check 'claude mcp list'"
  fi

  echo ""
  echo "## Recent runs"
  local last_log
  last_log=$(ls -t "$RUNS_DIR"/*.log 2>/dev/null | head -1)
  if [[ -n "$last_log" ]]; then
    local age_h
    age_h=$(( ( $(date +%s) - $(stat -f %m "$last_log") ) / 3600 ))
    if [[ $age_h -lt 26 ]]; then check_ok  "last run: $(basename "$last_log") (${age_h}h ago)"
    elif [[ $age_h -lt 72 ]]; then check_warn "last run is ${age_h}h ago — schedule may not be firing"
    else                           check_fail "last run is ${age_h}h ago — agent appears stalled"; fi
  else
    check_warn "no runs yet in $RUNS_DIR — first scheduled run hasn't fired"
  fi

  echo ""
  echo "## Disk"
  local install_kb install_mb
  install_kb=$(du -sk "$ROUTINE_DIR" 2>/dev/null | awk '{print $1}')
  install_mb=$(( install_kb / 1024 ))
  if [[ $install_mb -lt 500 ]]; then check_ok "install dir: ${install_mb}M"
  elif [[ $install_mb -lt 2000 ]]; then check_warn "install dir: ${install_mb}M (consider pruning runs/ + patches/)"
  else check_fail "install dir: ${install_mb}M — runs/ + patches/ + checkpoints/ likely need cleanup"; fi

  local snap_count
  snap_count=$(find "$ROUTINE_DIR/checkpoints" -maxdepth 1 -name 'snap-*' -type d 2>/dev/null | wc -l | tr -d ' ')
  if [[ $snap_count -gt 30 ]]; then check_warn "$snap_count snapshots in checkpoints/ (auto-prune keeps 14d)"
  else check_ok "$snap_count snapshots in checkpoints/"; fi

  echo ""
  echo "----"
  if [[ $fails -eq 0 && $warns -eq 0 ]]; then
    printf "\033[32m✓ All clear: $ok_count checks pass.\033[0m\n"
    return 0
  elif [[ $fails -eq 0 ]]; then
    printf "\033[33m! $ok_count OK, $warns warning(s).\033[0m\n"
    return 0
  else
    printf "\033[31m✗ $ok_count OK, $warns warning(s), $fails failure(s).\033[0m\n"
    return 1
  fi
}

cmd_uninstall() {
  local confirm="${1:-}"
  if [[ "$confirm" != "--yes" ]]; then
    cat <<EOF
This will:
  1. launchctl bootout the night-shift launchd job(s)
  2. Remove ~/Library/LaunchAgents/com.{{ user_short }}.night-shift-*.plist

It will NOT delete $ROUTINE_DIR (your install) or $USER_REPO (your project).
To remove the install dir afterwards, run:
  rm -rf "$ROUTINE_DIR"

Re-run with --yes to proceed.
EOF
    return 0
  fi

  local plist_dir="$HOME/Library/LaunchAgents"
  local found=0
  for plist in "$plist_dir"/com.{{ user_short }}.night-shift-*.plist; do
    [[ -f "$plist" ]] || continue
    found=$((found+1))
    local label
    label=$(basename "$plist" .plist)
    echo "Unloading $label …"
    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
    rm -f "$plist"
    echo "  ✓ removed $plist"
  done
  if (( found == 0 )); then
    echo "No night-shift launchd plists found at $plist_dir."
  else
    echo ""
    echo "Done. $found plist(s) removed. Install dir kept at $ROUTINE_DIR."
  fi
}

# Main dispatch
case "${1:-}" in
  brief)     shift; cmd_brief "$@" ;;
  apply)     shift; cmd_apply "$@" ;;
  run)       shift; cmd_run "$@" ;;
  status)    shift; cmd_status "$@" ;;
  logs)      shift; cmd_logs "$@" ;;
  triage)    shift; cmd_triage "$@" ;;
  restore)   shift; cmd_restore "$@" ;;
  doctor)    shift; cmd_doctor "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  help|--help|-h|"") usage ;;
  *)
    echo "Unknown subcommand: $1" >&2
    usage
    exit 2
    ;;
esac
